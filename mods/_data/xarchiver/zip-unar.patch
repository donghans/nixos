+		archiver[type].test = zip_unar ? xa_unar_test : FUNC(standard, xa_zip_test, is7za, xa_7zip_test, lsar, xa_unar_test);
+		archiver[type].extract = zip_unar ? xa_unar_extract : FUNC(standard, xa_zip_extract, is7za, xa_7zip_extract, unar, xa_unar_extract);
 		archiver[type].add = FUNC(standard, xa_zip_add, is7za, xa_7zip_add, lsar, NULL);
 		archiver[type].delete = FUNC(standard, xa_zip_delete, is7za, xa_7zip_delete, lsar, NULL);
 	}
