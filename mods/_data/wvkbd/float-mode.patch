+static void
+run_mode_hook()
+{
+    if (!mode_hook)
+        return;
+    pid_t pid = fork();
+    if (pid == 0) {
+        sigset_t none;
+        sigemptyset(&none);
+        sigprocmask(SIG_SETMASK, &none, NULL);
+        setenv("WVKBD_MODE", floating ? "float" : "dock", 1);
+        execl("/bin/sh", "sh", "-c", mode_hook, (char *)NULL);
+        _exit(127);
+    }
+}
+
+static void
+set_floating(bool f, bool run_hook)
+{
+    if (floating == f)
+        return;
+    floating = f;
+    if (!hidden && layer_surface) {
+        hide();
+        show();
+    }
+    if (run_hook)
+        run_mode_hook();
+}
