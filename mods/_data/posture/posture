#!/usr/bin/env python3
"""posture — 자세(힌지 모드 등) 조회 CLI. 소비자 스크립트는 상태 파일을 직접 읽지 말고 이걸 쓴다.

  posture                 사람이 읽는 요약
  posture json            원본 상태(JSON) — 안전한 기본값 처리가 된 것
  posture get <키>        mode | angle | screen | keyboard | orientation   (값만 출력)
  posture watch           바뀔 때마다 한 줄씩 출력 (Ctrl+C 로 종료)

안전한 기본값을 **여기서 한 곳에** 처리한다: 서비스가 실행 중이 아니거나, 상태 파일이 없거나 깨졌거나, 스키마가 다르거나,
너무 오래됐으면 mode=laptop, orientation=null 로 본다 → 센서/서비스 문제로 키보드가 꺼진 채 남지 않는다.
시험용 환경변수: POSTURE_STATE_DIR, POSTURE_NO_SYSTEMCTL=1(서비스 실행 여부 확인 생략), POSTURE_SYSTEMCTL(systemctl 대신 쓸 명령)
"""
import json
import os
import subprocess
import sys
import time

STATE = os.path.join(os.environ.get("POSTURE_STATE_DIR", "/run/posture"), "state.json")
SCHEMA = 1
SAFE = {"schema": SCHEMA, "ts": 0, "mode": "laptop", "hinge": {"angle": None, "screen": None, "keyboard": None},
        "orientation": None, "sensors": {"hinge": "unavailable"}, "source": "default"}


def active() -> bool:
    if os.environ.get("POSTURE_NO_SYSTEMCTL"):
        return True
    return subprocess.run([os.environ.get("POSTURE_SYSTEMCTL", "systemctl"), "is-active", "--quiet", "posture-daemon.service"]).returncode == 0


def load() -> dict:
    if not active():
        return dict(SAFE)
    try:
        d = json.load(open(STATE))
        if d.get("schema") != SCHEMA or d.get("mode") not in ("laptop", "tent", "tablet"):
            return dict(SAFE)
        d["source"] = "daemon"
        return d
    except (OSError, ValueError):
        return dict(SAFE)


def field(d: dict, key: str):
    if key in ("angle", "screen", "keyboard"):
        return d["hinge"].get(key)
    return d.get(key)


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv else "summary"
    if cmd == "json":
        print(json.dumps(load(), ensure_ascii=False))
    elif cmd == "get":
        if len(argv) < 2:
            print("사용: posture get <mode|angle|screen|keyboard|orientation>", file=sys.stderr)
            return 2
        v = field(load(), argv[1])
        print("" if v is None else v)
    elif cmd == "watch":
        last = None
        while True:
            d = load()
            line = f"mode={d['mode']} angle={d['hinge'].get('angle')} orientation={d.get('orientation')}"
            if line != last:
                print(line, flush=True)
                last = line
            time.sleep(0.5)
    elif cmd == "summary":
        d = load()
        h = d["hinge"]
        print(f"모드: {d['mode']}   힌지 {h.get('angle')}° (화면 {h.get('screen')}° / 키보드 {h.get('keyboard')}°)   방향: {d.get('orientation')}   출처: {d['source']}")
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
