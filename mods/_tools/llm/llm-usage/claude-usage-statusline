#!/usr/bin/env python3
# Claude Code 상태 표시줄: 세션(5시간)·주간 한도 %를 보여주고, 값이 바뀔 때마다 limits.jsonl 에 한 줄 남긴다.
# 입력은 stdin JSON(statusLine 규약). 외부 전송 없음.
import json, sys, os, time
try:
    d = json.load(sys.stdin)
except Exception:
    print("usage: ?"); sys.exit(0)
rl = d.get("rate_limits") or {}
f = rl.get("five_hour") or {}
w = rl.get("seven_day") or {}
cost = (d.get("cost") or {}).get("total_cost_usd")
cw = d.get("context_window") or {}
fp, wp = f.get("used_percentage"), w.get("used_percentage")
def fmt(x): return "?" if x is None else (f"{x:.0f}" if isinstance(x, (int, float)) else str(x))
print(f"5h {fmt(fp)}% · 7d {fmt(wp)}% · ctx {fmt(cw.get('used_percentage'))}% · ${cost if cost is None else round(cost,2)}")
def account():
    # 한도 %는 계정 단위인데 statusLine 입력에는 계정이 없어 ~/.claude.json(CLAUDE_CONFIG_DIR 가 있으면 그 안)의 oauthAccount 에서 읽는다.
    for p in (os.path.join(os.environ.get("CLAUDE_CONFIG_DIR", ""), ".claude.json"), os.path.expanduser("~/.claude.json")):
        try:
            a = json.load(open(p)).get("oauthAccount") or {}
            if a.get("accountUuid"):
                # 플랜: userRateLimitTier(default_claude_max_5x → max_5x), 없으면 seatTier, 개인 Pro 계정은 둘 다 비어 있어 organizationType(claude_pro → pro)
                plan = (a.get("userRateLimitTier") or a.get("seatTier") or a.get("organizationType") or "").replace("default_claude_", "").replace("default_", "").replace("claude_", "") or None
                return a["accountUuid"], a.get("emailAddress"), plan
        except Exception:
            pass
    return None, None, None
try:
    base = os.path.expanduser("~/.local/share/claude-otel")
    os.makedirs(base, exist_ok=True)
    state = os.path.join(base, ".limits.last")
    key = json.dumps([fp, wp, None if cost is None else round(cost, 1), d.get("session_id")])
    last = open(state).read() if os.path.exists(state) else ""
    if key != last:
        open(state, "w").write(key)
        rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "session_id": d.get("session_id"),
               "five_hour": f, "seven_day": w, "cost_usd": cost,
               "model": (d.get("model") or {}).get("id") or (d.get("model") or {}).get("display_name"),
               "context_used_pct": cw.get("used_percentage")}
        rec["account_id"], rec["account_email"], rec["account_plan"] = account()
        open(os.path.join(base, "limits.jsonl"), "a").write(json.dumps(rec, ensure_ascii=False) + "\n")
except Exception:
    pass
