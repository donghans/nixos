{
  "groups": {
    "step-ca": {
      "repo": "donghans/lightsail-nixos-headscale-secrets",
      "secrets": {
        "lightsail-nixos-headscale/step-ca/intermediate_ca.key": "var/lib/nix-secrets/step-ca/intermediate_ca.key",
        "lightsail-nixos-headscale/step-ca/password":            "var/lib/nix-secrets/step-ca/password"
      }
    },
    "cloudflare": {
      "repo": "donghans/lightsail-nixos-headscale-secrets",
      "secrets": {
        "lightsail-nixos-headscale/cloudflare/token": "var/lib/nix-secrets/cloudflare/token"
      }
    },
    "headscale": {
      "repo": "donghans/lightsail-nixos-headscale-secrets",
      "secrets": {
        "lightsail-nixos-headscale/headscale/oidc_client_secret": "var/lib/nix-secrets/headscale/oidc_client_secret"
      }
    }
  }
}
