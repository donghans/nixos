{
  "appId": "3995077",
  "groups": {
    "github-apps": {
      "repo": "BITSTEP-IT/headscale-backup",
      "installationId": "138797641",
      "secrets": {
        "github-apps/private-key": "var/lib/nix-secrets/github-apps/private-key.pem"
      }
    },
    "headscale": {
      "repo": "donghans/aws-headscale-secrets",
      "secrets": {
        "ec2-nixos-headscale/headscale/oidc_client_secret": "var/lib/nix-secrets/headscale/oidc_client_secret"
      }
    },
    "ec2-keypair": {
      "repo": "donghans/aws-headscale-secrets",
      "secrets": {
        "ec2-nixos-headscale/ec2-keypair/id": "var/lib/nix-secrets/ec2-keypair/id",
        "ec2-nixos-headscale/ec2-keypair/id.pub": "var/lib/nix-secrets/ec2-keypair/id.pub"
      }
    },
    "lightsail": {
      "repo": "donghans/aws-headscale-secrets",
      "secrets": {
        "ec2-nixos-headscale/lightsail/ts-state": "var/lib/nix-secrets/lightsail/ts-state",
        "ec2-nixos-headscale/lightsail/ssh-key": "var/lib/nix-secrets/lightsail/ssh-key"
      }
    }
  }
}
