#!/usr/bin/env bash
# sbox — 일회용 격리 환경(sboxbr0)을 만들고 꺼내고 지우는 호스트용 스크립트 (plan dev-sandbox-pilot §11·§15, 로드맵 P6)
# 종류(--kind): vm = nixos OS 단위 시험용 VM(구현됨). ct = 프로젝트용 컨테이너(v1: debian·ubuntu — §23 S1). 종류는 필수 인자이고 기본값이 없다.
# 이름: sbox-vm-<이름> / sbox-ct-<flavor><버전(점 제거)>-<이름>(예 sbox-ct-debian13-proj), 골든은 sbox-golden-vm(VM 전용). VM 안 사용자 이름은 sbox, 호스트명은 sbox-nixos(2026-11-22 devvm·dev-nixos 에서 변경).
#
#   sboxctl create --kind ct --flavor debian|ubuntu [--release R] [--legacy] [--nesting] [--cpu N] [--memory M] [--disk 용량] (--from-repo DIR|--manifest F|--no-project) [NAME]  컨테이너 생성(v1)
#   sboxctl releases [flavor]                          쓸 수 있는 릴리스 표(core/sbox/releases.toml)
#   sboxctl create --kind vm [NAME] [--no-cache] [--no-token] [--no-home]   골든 이미지에서 새 VM 생성(기본 이름 sbox-vm-YYMMDD-HHMM)
#   (ct 만) create 에 --from-repo DIR | --manifest F | --tool TOOL[=SPEC] (반복) | --update 를 주면 만든 직후 도구 층을 자동 적용 — 같은 매니페스트로 다시 만들면 같은 버전
#   sboxctl tools NAME [--from-repo DIR|--manifest F] [--update] [node=22]  컨테이너에 읽기 전용 도구 층 붙임(호스트가 받아 sha256 검증, 버전은 매니페스트에 고정, v1: node)
#   sboxctl docker NAME [--from-repo DIR|--manifest F] [--update] [--no-compose]  컨테이너(ct, --nesting 필수) 안에 rootless Docker 설치(공식 apt, 키는 호스트가 고정 보관·교차 확인, 버전은 쿨다운 적용·매니페스트에 고정, Compose 는 도구 층) — 설치 뒤 buildx(도구 층)·ct 안 특권 포트 sysctl(80 이상)·Docker 정리 자동화(builder gc 4GB + 매일 미태그 이미지·72h 넘은 중단 컨테이너 정리)
#   (ct 만) create 는 기본으로 --nesting 을 켜고 Docker 까지 설치한다(늘 쓰는 도구 — 사용자 2026-11-23). 끄려면 --no-docker(이번 한 번) 또는 매니페스트 [override] docker = "no"(영구)
#   sboxctl llm AGENT NAME [--dir D] [--bypass] [--attach] [--version V] [--update]  안(vm·ct)에서 tmux 로 LLM 에이전트 대화형 세션 시작(정의 core/sbox/llm.toml, 첫 실행 안내 미리 처리·남으면 경고).
#   sboxctl bundle NAME                               VM 안 저장소를 git bundle 로 호스트에 꺼냄(지우기 전 규율)
#   sboxctl import BUNDLE                             번들을 호스트 저장소의 refs/sbox/<VM>/* 로만 가져옴(병합·체크아웃 안 함) + 새 커밋 목록
#   sboxctl destroy NAME [--force] [--discard-dirty]  번들을 먼저 꺼내고 지움(번들 실패·미커밋 변경 있으면 거부)
#   sboxctl golden [SRC_INSTANCE]                     SRC(기본 dev-nixos)를 정상 종료 후 복제해 골든(sbox-golden-vm@gold)을 새로 만듦
#   sboxctl rebuild-golden [--stale-ok]               ISO+nixstrap(NIXSTRAP_AUTO)로 골든을 처음부터 새로 만듦(약 15분)
#   sboxctl broker create|status|update               L7 관문(broker) ct 생성·상태 — 프로젝트 ct 의 모든 외부 연결은 이 ct 의 CONNECT 프록시만 거친다(S61, pilot §29-25)
#   sboxctl egress NAME [--from-repo DIR|--manifest F] [--allow host[:port]]... [--minimal]  ct 를 broker 에 연결(--minimal = 프로젝트 없이 always+flavor 최소 세트만. 인자 없으면 create 때 기록한 user.sbox.manifest·egress-minimal 사용 NIC ACL·프록시 환경·허용목록). create 는 broker 가 있으면 자동으로 부른다
#   sboxctl audit [NAME…]                             격리 불변식 점검(읽기 전용) — raw.*·특권·낯선 장치·프로필 이탈·포트 격리·idmap 과 방식 B(ct NIC ACL·공유 ACL·broker 게이트웨이 ip_forward=0/forward drop·호스트 sbox-guard)를 sboxctl 이 만든 모양과 대조(S62)
#   sboxctl scan --from-repo DIR [--manifest F] [--flavor F]  저장소(Dockerfile·compose)를 읽기만 해서 필요한 송신 프리셋·주소를 제안(허용은 사람이 매니페스트 [network] 에 옮김, 휴리스틱)
#   sboxctl resources NAME                            기존 ct 를 sbox.slice(합계 자원 상한) 아래로 옮기고 sbox-mem 설치(재시작 필요, S69)
#   sboxctl list                                      sbox-* 인스턴스 목록
#   sboxctl iso [--stale-ok]                          설치 ISO 만 미리 빌드(캐시면 약 20초, nixstrap 수정 직후면 약 7분)
#   sboxctl depwatch scan|list|report|tier NAME general|critical  프로젝트 의존성 위험 신호 점검(읽기 전용·감지만, plan sbox-depwatch) — list·report 는 --json(ctl 공통 봉투)
#
# 전제·한계
#  - 호스트(msi-summit-me) 전용: incus 사용 권한, sboxbr0 브리지, nix-serve(10.100.1.1:5000) 필요.
#  - 제어 채널은 incus exec(에이전트) — ssh 로의 전환은 별도 단계(plan §11).
#  - 캐시 등록은 VM 의 /etc/nix/nix.conf 심볼릭 링크를 파일로 바꾸는 방식이라 VM 안에서 `nixup`(시스템 적용)을 하면 되돌아간다.
#    그때는 `sboxctl cache NAME` 으로 다시 등록한다.
#  - 토큰은 VM 의 tmpfs(/run/sbox-claude/token)에만 둔다(재부팅하면 사라짐). 값은 명령줄·디스크에 남기지 않는다.
set -euo pipefail

GOLDEN_INST="${SBOX_GOLDEN_INST:-sbox-golden-vm}"   # 정지 상태로만 둔다. 스냅샷 gold 가 복제 원본
GOLDEN_SNAP="gold"
GOLDEN_SRC_DEFAULT="${SBOX_GOLDEN_SRC:-dev-nixos}"
NETWORK="sboxbr0"
CACHE_URL="http://10.100.1.1:5000"
CACHE_KEY_DEFAULT="devbr0-nix-serve:V+CdKcL1BZ5sgn4t7xsRsffYkG11gkjcqRThEp51034="
CACHE_PUB_FILE="/var/lib/nix-serve-devbr0/cache-pub-key.pem"
VM_USER="sbox"
VM_UID=""   # VM 마다 다르다(다시 만든 골든은 1000, 이름을 바꿔 만든 옛 골든은 1001) — resolve_ids 가 VM 안에서 조회한다
VM_GID=""
VM_IDS_FOR=""
VM_HOME="/home/$VM_USER"
VM_REPO="$VM_HOME/nixos"
TOKEN_PATH="/run/sbox-claude/token"
BUNDLE_DIR="${SBOX_BUNDLE_DIR:-$HOME/.local/share/sbox/bundles}"
# 골든에 처음부터 있는 파일(nixstrap 이 만든 호스트 파일·nixup 이 매번 건드리는 락)은 「미커밋 변경」으로 세지 않는다
DIRTY_IGNORE="${SBOX_DIRTY_IGNORE:-^(( M)|(\?\?)) (\.locks/_rolling\.lock|hosts/sbox-nixos\.(nix|toml))$}"
VM_PATH="/run/wrappers/bin:/run/current-system/sw/bin:/bin" # incus exec 의 PATH 는 비어 있다(함정)
CT_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" # 컨테이너(debian·ubuntu 등 FHS 배포판)용
EXEC_PATH="$VM_PATH"   # vmx·vmu 등이 쓰는 PATH — check_name 이 종류에 맞게 바꾼다
NAME_KIND=""           # check_name 이 vm|ct 로 채운다
SBOX_DIR="$(dirname "$(readlink -f "$0")")/../sbox"   # releases.toml·release.py

AUDIT_LOG="${SBOX_AUDIT_LOG:-$HOME/.local/state/sbox/audit.log}"

# 감사 기록: 한 줄 JSON(시각·이벤트·VM·상세)을 남기고 데스크톱 알림을 보낸다(앱 이름 `sbox` — 알림 센터 `notif` 에 모인다).
# 수준: info(생성·삭제·번들 등 평시 기록) / critical(실패·--force 같이 눈에 띄어야 하는 것 — 알림 센터의 「시스템 문제」로 분류됨).
# 비밀 값은 넣지 않는다(토큰은 「주입했다」는 사실과 바이트 수만).
audit() { # audit LEVEL EVENT NAME DETAIL
    local level=$1 event=$2 name=${3:-} detail=${4:-}
    mkdir -p "$(dirname "$AUDIT_LOG")"
    python3 -c 'import json,sys,time,os;print(json.dumps({"ts":time.strftime("%Y-%m-%dT%H:%M:%S%z"),"level":sys.argv[1],"event":sys.argv[2],"vm":sys.argv[3],"kind":("vm" if sys.argv[3].startswith(("sbox-vm-","sbox-golden-vm")) else "ct" if sys.argv[3].startswith("sbox-ct-") else ""),"flavor":os.environ.get("AUDIT_FLAVOR",""),"release":os.environ.get("AUDIT_RELEASE",""),"eol":os.environ.get("AUDIT_EOL",""),"detail":sys.argv[4]},ensure_ascii=False))' \
        "$level" "$event" "$name" "$detail" >>"$AUDIT_LOG" 2>/dev/null || true
    if command -v notify-send >/dev/null 2>&1; then
        local urg=normal; [[ $level == critical ]] && urg=critical
        notify-send -a sbox -u "$urg" "sbox $event${name:+: $name}" "$detail" >/dev/null 2>&1 || true
    fi
}

die() { printf 'sbox: %s\n' "$*" >&2; audit critical error "${SBOX_CUR:-}" "$*"; exit 1; }
say() { printf 'sbox: %s\n' "$*" >&2; }

vmx() { # vmx NAME CMD… — VM 안에서 root 로 실행
    local name=$1; shift
    incus exec "$name" --env "PATH=$EXEC_PATH" -- "$@"
}
vmx_env() { # vmx_env NAME VAR=VAL… -- CMD… — 표준입력을 그대로 넘기며 환경변수를 주고 root 로 실행
    local name=$1; shift
    local -a envs=(--env "PATH=$EXEC_PATH")
    while [[ ${1:-} != -- ]]; do envs+=(--env "$1"); shift; done
    shift
    incus exec "$name" "${envs[@]}" -- "$@"
}
resolve_ids() { # resolve_ids NAME — VM 안 sbox 사용자의 uid·gid 를 조회해 둔다(VM 별 1회)
    [[ $VM_IDS_FOR == "$1" ]] && return 0
    VM_UID=$(incus exec "$1" --env "PATH=$EXEC_PATH" -- id -u "$VM_USER") || die "$1 에서 사용자 $VM_USER 를 찾지 못했습니다"
    VM_GID=$(incus exec "$1" --env "PATH=$EXEC_PATH" -- id -g "$VM_USER")
    VM_IDS_FOR=$1
}
vmu() { # vmu NAME CMD… — VM 안에서 sbox 사용자로 실행
    local name=$1; shift
    resolve_ids "$name"
    local -a extra=()
    [[ -n ${NIX_CFG:-} ]] && extra=(--env "NIX_CONFIG=$NIX_CFG")
    incus exec "$name" --user "$VM_UID" --group "$VM_GID" --env "HOME=$VM_HOME" --env "PATH=$EXEC_PATH" "${extra[@]}" -- "$@"
}

check_name() {
    SBOX_CUR=${1:-}
    [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "인스턴스 이름이 필요합니다(소문자·숫자·하이픈)"
    [[ "$1" != "$GOLDEN_INST" ]] || die "$GOLDEN_INST 는 골든 원본이라 이 명령으로 다루지 않습니다"
    # 사람이 쓰는 상시 VM·다른 인스턴스를 실수로 건드리지 않게 sbox-vm-·sbox-ct- 접두사만 허용. 종류별 정책은 이름에서 정해진다(plan §15 조건 ②).
    case "$1" in
        sbox-vm-*) NAME_KIND=vm; EXEC_PATH=$VM_PATH ;;
        sbox-ct-*) NAME_KIND=ct; EXEC_PATH=$CT_PATH ;;
        *) die "이 스크립트는 sbox-vm-<이름>·sbox-ct-<flavor><버전>-<이름> 인스턴스만 다룹니다(받은 이름: $1)" ;;
    esac
}

require_vm() { [[ $NAME_KIND == vm ]] || die "이 명령은 vm 종류(nixos) 전용입니다 — $SBOX_CUR 는 $NAME_KIND"; }

wait_agent() {
    local name=$1 ok=0
    for _ in $(seq 1 90); do
        if vmx "$name" true >/dev/null 2>&1; then ok=1; break; fi
        sleep 2
    done
    ((ok)) || die "$name 의 에이전트가 180초 안에 응답하지 않았습니다"
    # 에이전트는 DHCP 보다 먼저 응답한다 — 기본 경로(=네트워크)가 생길 때까지 최대 60초 더 기다린다
    for _ in $(seq 1 30); do
        vmx "$name" sh -c 'ip route 2>/dev/null | grep -q "^default"' >/dev/null 2>&1 && return 0
        sleep 2
    done
    die "$name 의 네트워크(기본 경로)가 60초 안에 올라오지 않았습니다"
}

cmd_golden() {
    local src=${1:-$GOLDEN_SRC_DEFAULT}
    # 이미지 게시(incus publish)는 쓰지 않는다: 2026-11-22 시험에서 이미지로 만든 VM 의 nix 스토어 파일 일부가 0바이트로 깨졌다
    # (하드링크 파일). 또 실행 중인 VM 의 스냅샷은 디스크에 안 내려간 쓰기가 빠져 같은 증상이 난다 → 반드시 정상 종료 뒤 복제.
    incus info "$src" >/dev/null 2>&1 || die "원본 인스턴스 $src 가 없습니다"
    incus info "$GOLDEN_INST" >/dev/null 2>&1 && die "$GOLDEN_INST 가 이미 있습니다 — 새로 만들려면 'incus delete -f $GOLDEN_INST' 를 먼저(파괴적이라 직접)"
    local was_running=0
    [[ $(incus list "$src" -f csv -c s) == RUNNING ]] && was_running=1
    ((was_running)) && { say "$src 정상 종료(복제 일관성)"; incus stop "$src"; }
    incus copy "$src" "$GOLDEN_INST" --instance-only
    ((was_running)) && incus start "$src"
    # 인증정보·작업 잔재 정리 후 스냅샷: 골든은 한 번 켜서 정리하고 끈다
    incus start "$GOLDEN_INST"; wait_agent "$GOLDEN_INST"
    vmx "$GOLDEN_INST" sh -c "rm -f $VM_HOME/.claude/history.jsonl; sync"
    incus stop "$GOLDEN_INST"
    incus snapshot create "$GOLDEN_INST" "$GOLDEN_SNAP"
    audit info golden "$GOLDEN_INST" "$src 정상 종료 복제 → $GOLDEN_INST@$GOLDEN_SNAP"
}

build_iso() { # build_iso STALE_OK — ISO 를 빌드(변경 없으면 캐시)하고 경로를 ISO_PATH 에 둔다
    local stale_ok=$1 repo build_dir=${XDG_CACHE_HOME:-$HOME/.cache}/nixos/build
    repo=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
    # 빌드 사본(.build 는 nixup 이 만든 사본)이 낡았으면 ISO 의 nixstrap 도 낡다 — 먼저 `nixup check` 로 갱신
    if ((!stale_ok)) && ! diff -q "$build_dir/core/scripts/nixstrap.sh" "$repo/core/scripts/nixstrap.sh" >/dev/null 2>&1; then
        die "빌드 사본($build_dir)의 nixstrap.sh 가 저장소와 다릅니다 — 'nixup check' 로 갱신하거나 --stale-ok"
    fi
    if ((!stale_ok)) && ! diff -q "$build_dir/core/scripts/nixstrap.task-install.sh" "$repo/core/scripts/nixstrap.task-install.sh" >/dev/null 2>&1; then
        die "빌드 사본($build_dir)의 nixstrap.task-install.sh 가 저장소와 다릅니다 — 'nixup check' 로 갱신하거나 --stale-ok"
    fi
    local t0=$SECONDS iso_link=${XDG_CACHE_HOME:-$HOME/.cache}/nixos/dev-iso
    say "ISO 빌드(변경 없으면 캐시)"
    nix build "path:$build_dir#nixosConfigurations.custom-iso.config.system.build.isoImage" --impure --out-link "$iso_link" >&2 \
        || die "ISO 빌드 실패"
    ISO_PATH=$(find "$(readlink -f "$iso_link")/iso" -maxdepth 1 -name '*.iso' 2>/dev/null | head -1)
    [[ -r $ISO_PATH ]] || die "ISO 파일을 찾지 못했습니다($iso_link)"
    say "ISO 준비 완료($((SECONDS - t0))초): $ISO_PATH"
}

cmd_iso() { # 미리 빌드해 두면 rebuild-golden 이 ISO 대기 없이(약 20초) 시작한다. 결과는 ~/.cache/nixos/dev-iso 에 GC 루트로 남는다
    local stale_ok=0
    [[ ${1:-} == --stale-ok ]] && stale_ok=1
    build_iso "$stale_ok"
    audit info iso "" "$ISO_PATH"
}

cmd_rebuild_golden() {
    local stale_ok=0
    [[ ${1:-} == --stale-ok ]] && stale_ok=1
    incus info "$GOLDEN_INST" >/dev/null 2>&1 && die "$GOLDEN_INST 가 이미 있습니다 — 다른 이름은 SBOX_GOLDEN_INST=… 로, 교체는 'incus delete -f' 를 직접(파괴적)"
    local repo t0=$SECONDS iso
    repo=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
    build_iso "$stale_ok"
    iso=$ISO_PATH

    SBOX_CUR=$GOLDEN_INST
    local t_init=$SECONDS
    # incus 생성 클라이언트가 응답 없이 수십 분 멈추거나 실패한 적이 있다(2026-11-22 네 번, 원인 미확인 — 같은 이름 재사용만의 문제는 아님:
    # 새 이름으로도 재현). 오류를 숨기지 않고 보여 주며 시간 제한 후 최대 3번 재시도한다.
    local _try _err
    for _try in 1 2 3; do
        if _err=$(timeout 120 incus init --empty --vm "$GOLDEN_INST" -n "$NETWORK" -c limits.cpu=4 -c limits.memory=8GiB \
            -c security.secureboot=false -d root,size=120GiB 2>&1 </dev/null); then break; fi
        say "incus init 실패($_try/3): ${_err##*$'\n'}"
        incus delete -f "$GOLDEN_INST" >/dev/null 2>&1 || true
        sleep 10
        [[ $_try == 3 ]] && die "incus init 3회 실패($GOLDEN_INST): ${_err##*$'\n'}"
    done
    say "incus init $((SECONDS - t_init))초"
    incus config device add "$GOLDEN_INST" iso disk source="$iso" boot.priority=10 >/dev/null
    incus start "$GOLDEN_INST"
    wait_agent "$GOLDEN_INST"

    # PARAMS_FILE: 선택값을 미리 적는다(nixstrap 의 save_params 형식). 디스크 전체 삭제는 이 빈 VM 의 가상 디스크(sda)에만 적용된다.
    # 부트 영역 끝값은 호스트에서 같은 스크립트로 계산한다(ISO 의 기본 PATH 에는 python3 가 없고 nixstrap-wrapped 만 자기 PATH 에 넣어 쓴다)
    local boot_end
    boot_end=$(python3 "$repo/core/scripts/nixstrap.lib-part.py" boot-end 1MiB 1GiB) || die "boot-end 계산 실패"
    [[ $(vmx "$GOLDEN_INST" sh -c 'lsblk -dno SIZE,TYPE /dev/sda') == *disk* ]] || die "/dev/sda 가 없습니다"
    vmx "$GOLDEN_INST" sh -c "cat > /root/nixstrap-params.env" <<PARAMS_EOF
NIXOS_REPO=donghans/nixos
HOST=sbox-nixos
_HOST_IS_NEW=true
_HOST_TYPE=
_HOST_PRESET_FROM_REPO=
_PRESET=workstation
_STATE_VERSION=
_HOST_USERNAME=$VM_USER
_PART_MODE=2
_NEW_PARTITIONS=true
BOOT_PART=/dev/sda1
ROOT_PART=/dev/sda2
FORMAT_BOOT=y
FORMAT_ROOT=y
_DISK=/dev/sda
_WIPE=true
_PART_START=1MiB
_PART_END=100%
_BOOT_SIZE=1GiB
_BOOT_END=$boot_end
_NEW_BOOT_NUM=1
_NEW_ROOT_NUM=2
_SSH_ACCESS_MODE=
_SSH_KEY_FILE=
_SSH_KEY_GENERATED=false
_LUKS=false
_IS_LAPTOP=false
_REFIND=false
PARAMS_EOF
    audit info rebuild-golden "$GOLDEN_INST" "ISO 부팅·params 주입 완료, nixstrap 시작($((SECONDS - t0))초)"
    # 비밀번호: 무작위로 만들어 표준입력으로만 넘긴다(저장·출력 안 함). VM 안 Claude 가 sudo 를 못 쓰게 하는 방침과 같다 —
    # 관리가 필요하면 호스트에서 incus exec(root) 로 하거나 passwd 로 새로 정한다.
    local log
    log=${SBOX_INSTALL_LOG:-$HOME/.local/state/sbox/rebuild-golden-$(date +%y%m%d-%H%M%S).log}
    mkdir -p "$(dirname "$log")"
    say "nixstrap 자동 설치 시작(로그 $log)"
    # 설치 중에도 호스트 nix-serve 캐시를 쓴다(공개 캐시에 없는 로컬 빌드물을 재빌드하지 않게). 라이브 환경의 root 는 신뢰 사용자라 NIX_CONFIG 가 먹는다.
    local nixcfg
    nixcfg=$(printf 'extra-substituters = %s\nextra-trusted-public-keys = %s' "$CACHE_URL" "$(cache_key)")
    # 에이전트는 DHCP 보다 먼저 응답하므로 네트워크가 올라올 때까지 최대 60초 기다린다
    local _n up=0
    for _n in $(seq 1 30); do
        vmx "$GOLDEN_INST" curl -sf --max-time 3 "$CACHE_URL/nix-cache-info" >/dev/null 2>&1 && { up=1; break; }
        sleep 2
    done
    ((up)) || die "라이브 환경에서 캐시($CACHE_URL)에 닿지 않습니다(60초 대기)"
    if ! head -c 18 /dev/urandom | base64 | vmx_env "$GOLDEN_INST" NIXSTRAP_AUTO=1 TERM=dumb "NIX_CONFIG=$nixcfg" -- nixstrap-wrapped >"$log" 2>&1; then
        die "nixstrap 설치 실패 — 로그: $log (VM $GOLDEN_INST 는 남겨 둡니다)"
    fi
    say "설치 끝($((SECONDS - t0))초) — 재부팅"
    incus stop "$GOLDEN_INST"
    incus config device remove "$GOLDEN_INST" iso
    incus config set "$GOLDEN_INST" raw.qemu="-cpu host,-vmx"
    incus start "$GOLDEN_INST"
    wait_agent "$GOLDEN_INST"
    # 홈이 설치 중에 적용되지 않았으면 여기서 적용
    if ! vmu "$GOLDEN_INST" test -x "$VM_HOME/.nix-profile/bin/claude"; then
        say "설치 중 홈 적용이 안 됐음 — 재부팅 뒤 nixup home"
        home_apply "$GOLDEN_INST"
    fi
    vmu "$GOLDEN_INST" test -x "$VM_HOME/.nix-profile/bin/claude" || die "골든에 claude 가 없습니다"
    vmx "$GOLDEN_INST" sh -c "rm -f $VM_HOME/.nixstrap-first-run; sync"
    incus stop "$GOLDEN_INST"
    incus snapshot create "$GOLDEN_INST" "$GOLDEN_SNAP"
    audit info rebuild-golden "$GOLDEN_INST" "처음부터 재생성 완료($((SECONDS - t0))초)"
    say "완료: $GOLDEN_INST@$GOLDEN_SNAP ($((SECONDS - t0))초)"
}

cache_key() { # 호스트 nix-serve 의 공개키(읽을 수 있으면 호스트 파일, 아니면 기본값)
    local key=$CACHE_KEY_DEFAULT
    if [[ -r $CACHE_PUB_FILE ]]; then
        key=$(<"$CACHE_PUB_FILE")
        [[ $key == "$CACHE_KEY_DEFAULT" ]] || say "주의: 호스트 공개키가 기본값과 다릅니다 — 호스트 키($CACHE_PUB_FILE)를 씁니다"
    fi
    printf '%s' "$key"
}

cmd_cache() {
    local name=$1 key
    check_name "$name"
    require_vm
    key=$(cache_key)
    # nix.conf 는 /etc/static 으로의 심볼릭 링크(읽기 전용) — 파일로 바꾸고 extra-* 한 줄씩 덧붙인다. 이미 있으면 건너뜀.
    # shellcheck disable=SC2016  # 작은따옴표 안의 $1·$2 는 VM 쪽 셸이 펼친다
    vmx "$name" sh -c '
        set -e
        conf=/etc/nix/nix.conf
        [ -L "$conf" ] && cp --remove-destination "$(readlink -f "$conf")" "$conf" && chmod 644 "$conf"
        grep -qF "$1" "$conf" || printf "extra-substituters = %s\n" "$1" >> "$conf"
        grep -qF "$2" "$conf" || printf "extra-trusted-public-keys = %s\n" "$2" >> "$conf"
        systemctl restart nix-daemon
    ' sh "$CACHE_URL" "$key"
    # 접근 확인: VM → 캐시
    if vmx "$name" curl -sf --max-time 10 "$CACHE_URL/nix-cache-info" >/dev/null; then
        say "캐시 등록·접근 확인 완료($CACHE_URL)"
        audit info cache "$name" "$CACHE_URL 등록·접근 확인"
    else
        die "캐시 등록은 했으나 VM 에서 $CACHE_URL 에 닿지 않습니다(호스트 nix-serve·sbox-guard 확인)"
    fi
}

cmd_home() { check_name "${1:-}"; require_vm; home_apply "$1"; }

home_apply() { # 이름 규칙 검사 없이 홈 적용(rebuild-golden 이 골든 이름으로도 부른다)
    local name=$1
    resolve_ids "$name"
    # nixup 은 ~/.cache/nixos/build/hardware.nix 가 없으면 sudo 로 만들려 한다 — 터미널이 없어 실패하므로 root 가 미리 만들어 둔다.
    vmx "$name" sh -c "
        set -e
        d=$VM_HOME/.cache/nixos/build; mkdir -p \$d
        [ -s \$d/hardware.nix ] || nixos-generate-config --no-filesystems --show-hardware-config > \$d/hardware.nix
        chown -R $VM_UID:$VM_GID $VM_HOME/.cache" || { audit critical home "$name" "hardware.nix 준비 실패"; return 0; }
    # 호스트 nix-serve 캐시를 이 호출에만 적용한다(NIX_CONFIG — sbox 사용자는 wheel 이라 신뢰 사용자). 이미지·nix.conf 는 건드리지 않는다.
    local NIX_CFG
    NIX_CFG=$(printf 'extra-substituters = %s\nextra-trusted-public-keys = %s' "$CACHE_URL" "$(cache_key)")
    # 골든에는 홈 프로필이 이미 있어 보통 몇 초 안에 끝난다. 실패해도 생성 전체를 막지는 않고 critical 로 알린다.
    if vmu "$name" sh -c "cd $VM_REPO && USER=$VM_USER nixup home" >/dev/null 2>&1; then
        vmu "$name" test -x "$VM_HOME/.nix-profile/bin/claude" || { audit critical home "$name" "nixup home 은 끝났으나 claude 가 없음"; return 0; }
        audit info home "$name" "nixup home 완료, claude 확인"
    else
        audit critical home "$name" "nixup home 실패 — VM 안에서 직접 확인 필요"
    fi
}

cmd_token() { # cmd_token NAME [AGENT] [--inject] — 에이전트(기본 claude)의 토큰을 안쪽 tmpfs 에 주입. --inject: 진짜 토큰 대신 **자리표시자**를 넣고 broker 가 진짜 값을 붙이게 한다(S64, C안)
    local name=$1 agent=${2:-claude} inject=0
    [[ ${3:-} == --inject ]] && inject=1
    check_name "$name"
    if ((inject)); then
        [[ $agent == claude ]] || die "--inject 는 claude 만 지원합니다(Anthropic 어댑터)"
        incus info "$BROKER" >/dev/null 2>&1 </dev/null || die "broker 가 없습니다"
        local tpath ph rnd
        tpath=$(agent_get "$agent" token_path) || exit 1
        resolve_ids "$name"
        rnd=$(python3 -c 'import secrets,string;print("".join(secrets.choice(string.ascii_letters+string.digits) for _ in range(24)))')
        ph="sk-ant-oat01-sbox-placeholder-${name#sbox-ct-}-$rnd"     # 사람·스캐너가 가짜임을 알아보는 표지 + ct 별 난수(§29-58)
        python3 "$SBOX_DIR/egress.py" inject-set --state "$EGRESS_STATE" --name "$name" --placeholder "$ph" || die "자리표시자 등록 실패(먼저 'sboxctl egress $name')"
        broker_push
        printf %s "$ph" | incus exec "$name" --env PATH="$EXEC_PATH" -- sh -c "set -e; umask 077; d=\$(dirname $tpath); mkdir -p \$d; cat > $tpath; chown -R $VM_UID:$VM_GID \$d; chmod 700 \$d" </dev/stdin || die "자리표시자를 ct 에 넣지 못했습니다"
        audit info token "$name" "claude 자리표시자 주입(broker 가 진짜 값을 붙임, ct 에 진짜 토큰 없음)"
        say "자리표시자 주입 완료($agent: $tpath) — 진짜 토큰은 broker 에만 있습니다('sboxctl broker secret'). 세션은 'sboxctl llm' 이 ANTHROPIC_BASE_URL 을 자동으로 맞춥니다"
        return 0
    fi
    command -v donghans >/dev/null || die "donghans 명령이 없습니다"
    local secret tpath
    secret=$(agent_get "$agent" secret) || exit 1
    tpath=$(agent_get "$agent" token_path) || exit 1
    resolve_ids "$name"
    # 값은 환경변수 → 표준입력으로만 흐른다(명령줄에 없음). 파일은 안쪽 tmpfs, 0600, sbox 소유.
    # shellcheck disable=SC2016  # $… 는 donghans secret run 이 띄운 셸이 펼친다(명령줄에 값이 없게). 비밀 이름 = 환경변수 이름
    donghans secret run --env "$secret" -- sh -c '
        printf %s "$(printenv "$6")" | incus exec "$1" --env PATH="$2" -- sh -c "
            set -e; umask 077; d=\$(dirname $3); mkdir -p \$d; cat > $3
            chown -R $4:$5 \$d; chmod 700 \$d"
    ' sh "$name" "$EXEC_PATH" "$tpath" "$VM_UID" "$VM_GID" "$secret"
    local bytes
    bytes=$(vmx "$name" sh -c "wc -c < $tpath")
    [[ ${bytes//[[:space:]]/} -gt 20 ]] || die "토큰 파일이 비어 있거나 너무 짧습니다(${bytes}바이트)"
    audit info token "$name" "$secret 주입($agent, tmpfs, ${bytes//[[:space:]]/}바이트)"
    say "토큰 주입 완료($agent: tmpfs $tpath, ${bytes//[[:space:]]/}바이트, 값은 출력하지 않음)"
}

wait_ct() { # wait_ct NAME — 컨테이너가 exec 에 응답하고 기본 경로(네트워크)가 생길 때까지(최대 약 2분)
    local n=$1 ok=0
    for _ in $(seq 1 60); do
        incus exec "$n" --env "PATH=$CT_PATH" -- true >/dev/null 2>&1 </dev/null && { ok=1; break; }
        sleep 1
    done
    ((ok)) || die "$n 이 60초 안에 응답하지 않았습니다"
    for _ in $(seq 1 60); do
        incus exec "$n" --env "PATH=$CT_PATH" -- sh -c 'ip route 2>/dev/null | grep -q "^default"' >/dev/null 2>&1 </dev/null && return 0
        sleep 1
    done
    die "$n 의 네트워크(기본 경로)가 60초 안에 올라오지 않았습니다"
}

# 컨테이너 종류 v1 (plan dev-sandbox-pilot §23 S1~S3). 정책: 비특권만, 비 root 사용자 sbox 에 sudo 없음, 종료된 릴리스는 --legacy 필요.
create_ct() { # create_ct NAME FLAVOR RELEASE LEGACY NESTING CPU MEM TOKEN
    local name=$1 flavor=$2 release=$3 legacy=$4 nesting=$5 cpu=$6 mem=$7 token=$8 disk=${9:-}
    [[ -n $flavor ]] || die "ct 종류는 --flavor 가 필요합니다(debian|ubuntu)"
    case $flavor in
        debian|ubuntu) ;;
        arch|gentoo) die "$flavor 컨테이너는 아직 구현 전입니다(체크리스트 S7·S8)" ;;
        *) die "알 수 없는 flavor: $flavor (debian|ubuntu)" ;;
    esac
    local info key ver status eol image note
    info=$(python3 "$SBOX_DIR/release.py" resolve "$flavor" "$release") || die "릴리스 조회 실패"
    IFS=$'\x1f' read -r key ver status eol image note <<<"$info"   # 탭이 아니라 \x1f — 빈 종료일이 합쳐지면 필드가 밀린다(2026-11-22 실제로 겪음)
    export AUDIT_FLAVOR=$flavor AUDIT_RELEASE=$key AUDIT_EOL=false
    say "릴리스: $flavor $ver($key) 상태 $status${eol:+, 종료일 $eol}${note:+ — $note}"
    if [[ $status == eol ]]; then
        ((legacy)) || die "$flavor $ver($key)는 지원이 끝난 릴리스입니다 — 레거시·마이그레이션 목적이면 --legacy 를 주세요"
        AUDIT_EOL=true
        say "경고: $flavor $ver($key)는 지원 종료 릴리스입니다(보안 패치 없음). 네트워크는 sbox-guard 안에서만 나갑니다."
    fi
    if [[ $image == build:* ]]; then
        die "$flavor $ver($key)는 incus 이미지가 없어 직접 빌드해야 합니다(${image#build:}) — 방법은 plan dev-sandbox-pilot §22-3, 구현은 체크리스트 S9"
    fi
    local vclean=${ver//./}
    local want="sbox-ct-$flavor$vclean-"
    [[ -n $name ]] || name="$want$(date +%y%m%d-%H%M)"
    [[ $name == "$want"* ]] || die "이름은 $want 로 시작해야 합니다(받은 이름: $name) — 규칙: sbox-ct-<flavor><버전(점 제거)>-<이름>"
    check_name "$name"
    incus info "$name" >/dev/null 2>&1 && die "$name 은 이미 있습니다"
    incus network show "$NETWORK" >/dev/null 2>&1 || die "브리지 $NETWORK 가 없습니다"

    say "생성: $name ← images:$image (비특권 컨테이너, cpu $cpu·메모리 $mem$( ((nesting)) && echo ', nesting' ))"
    incus profile show sbox-ct >/dev/null 2>&1 </dev/null || die "프로필 sbox-ct 가 없습니다 — 호스트에 incus-sbox 모듈(mods/sys/services/incus-sbox.nix)이 적용돼야 합니다(nixup os)"
    # 메모리 한도는 소프트(memory.high)다 — 호스트 여유가 있으면 넘어 쓰고 압박일 때만 회수·지연, 죽이지 않는다(2026-11-23 시험: 1GiB 한도에서 1.8GiB 점유가 성공,
    # high 이벤트만 증가). 호스트 보호는 sbox.slice 의 합계 상한(incus-sbox.nix)이 맡는다. 상한 자체는 사용자 요청으로 높임(DB 스택을 Docker 로 다 띄우면 무겁다).
    mem_preflight "$mem"
    local -a opts=(-p sbox-ct -c "limits.cpu=$cpu" -c "limits.memory=$mem" -c limits.memory.enforce=soft)
    opts+=(-c "raw.lxc=$(slice_raw_lxc "$name")")
    # broker 가 있으면 ct 를 만들 때부터 .200–.250 고정 주소(S70-a) — DHCP 로 받은 주소는 DNS 가 열려 있는 범위라 쓰지 않는다
    if [[ $name != "$BROKER" ]] && incus info "$BROKER" >/dev/null 2>&1 </dev/null; then
        local _ctip; _ctip=$(alloc_ct_ip) || die "ct 고정 주소($CT_IP_PREFIX.$CT_IP_FIRST–$CT_IP_LAST)가 모두 쓰이고 있습니다"
        opts+=(-d "eth0,ipv4.address=$_ctip")
        say "고정 주소 $_ctip (broker 경유 전용 범위 — 게이트웨이 DNS 는 호스트가 막음)"
    fi
    [[ -n $disk ]] && opts+=(-d "root,size=$disk")
    ((nesting)) && opts+=(-c security.nesting=true)
    local _try _err
    for _try in 1 2 3; do
        if _err=$(timeout 180 incus init "images:$image" "$name" "${opts[@]}" 2>&1 </dev/null); then break; fi
        say "incus init 실패($_try/3): ${_err##*$'\n'}"
        incus delete -f "$name" >/dev/null 2>&1 </dev/null || true
        sleep 10
        [[ $_try == 3 ]] && die "incus init 3회 실패($name): ${_err##*$'\n'}"
    done
    # 정책 검사: 특권 컨테이너·호스트 장치 직결이 아닌지(프로필·인스턴스 합산 설정에서 확인). 어긋나면 만든 것을 지우고 거부.
    if incus config show "$name" --expanded 2>/dev/null </dev/null | grep -qE '^\s*security\.privileged:\s*"?true'; then
        incus delete -f "$name" >/dev/null 2>&1 </dev/null || true
        die "정책 위반: 특권 컨테이너가 됐습니다 — 거부하고 삭제했습니다"
    fi
    incus start "$name" </dev/null
    wait_ct "$name"
    # 비 root 사용자 sbox: sudo 그룹에 넣지 않는다(Claude 에게 root 를 주지 않는 방침 — plan §15)
    incus exec "$name" --env "PATH=$CT_PATH" -- sh -c "id $VM_USER >/dev/null 2>&1 || useradd -m -s /bin/bash $VM_USER" </dev/null \
        || die "사용자 $VM_USER 생성 실패"
    # broker 가 있으면 도구·Docker 설치(apt)보다 먼저 연결한다 — 이 범위의 ct 는 게이트웨이 DNS 를 못 쓰므로 apt 도 broker 프록시로 나가야 한다(S70-a)
    if [[ $name != "$BROKER" ]] && incus info "$BROKER" >/dev/null 2>&1 </dev/null; then
        ((EGRESS_MINIMAL)) && incus config set "$name" user.sbox.egress-minimal=1 </dev/null   # --no-project: 프로젝트 없이 최소 세트
        cmd_egress "$name" ${EGRESS_MAN:+--manifest "$EGRESS_MAN"} || die "$name 은 만들어졌지만 broker 연결에 실패했습니다 — 'sboxctl egress $name' 로 다시 시도하세요"
    fi
    ((token)) && cmd_token "$name"
    install_sbox_mem "$name" || say "경고: sbox-mem 설치 실패 — 'sboxctl resources $name' 로 다시 시도하세요"

    local ip
    ip=$(incus list "$name" -f json </dev/null | python3 -c 'import sys,json
d=json.load(sys.stdin)[0]["state"]["network"]
print(" ".join(a["address"] for a in d.get("eth0",{}).get("addresses",[]) if a["family"]=="inet"))')
    audit info create "$name" "컨테이너 images:$image, ${flavor} ${ver}(${key}) ${status}, $ip, 비특권, cpu $cpu·메모리 $mem"
    say "완료: $name  ($ip) — 사용자 $VM_USER(sudo 없음), 토큰은 $TOKEN_PATH(tmpfs)"
    if ((${#TOOLS_ARGS[@]})); then
        # 도구 층 자동 적용 — 매니페스트의 [resolved] 가 정확한 버전을 고정하므로 이 컨테이너를 지우고 다시 만들어도 같은 버전이 들어간다
        cmd_tools "$name" "${TOOLS_ARGS[@]}" || die "$name 은 만들어졌지만 도구 층 적용에 실패했습니다 — 'sboxctl tools $name …' 로 다시 시도하세요"
    fi
    if ((${DOCKER:-0})); then
        cmd_docker "$name" "${DOCKER_ARGS[@]}" || die "$name 은 만들어졌지만 Docker 설치에 실패했습니다 — 'sboxctl docker $name …' 로 다시 시도하세요"
    fi
    # 도구 적용으로 매니페스트가 생기거나 바뀌었을 수 있으니 허용목록을 다시 계산(처음 연결은 apt 를 위해 flavor·always 만으로 했음)
    if [[ $name != "$BROKER" ]] && incus info "$BROKER" >/dev/null 2>&1 </dev/null; then
        cmd_egress "$name" >/dev/null || say "경고: 허용목록 재계산 실패 — 'sboxctl egress $name' 로 다시 시도하세요"
    fi
    if ((${#TOOLS_ARGS[@]} == 0)); then
        say "알림: 도구(Node·Go·Rust·Python·Compose·uv)는 'sboxctl tools $name --from-repo <저장소>' 또는 create 의 --from-repo/--tool 로 읽기 전용 도구 층을 붙입니다"
    fi
}

cmd_create() {
    local name="" cache=1 token=1 home=1 kind="" flavor="" release="" legacy=0 nesting=0 cpu=2 mem="" disk="" docker=auto noproject=0
    EGRESS_MINIMAL=0
    TOOLS_ARGS=()   # ct 전용: 만든 직후 도구 층에 넘길 인자(--from-repo·--manifest·--tool·--update) — 다시 만들 때 같은 버전이 재적용되게
    while (($#)); do
        case $1 in
            --from-repo) TOOLS_ARGS+=(--from-repo "${2:?}"); shift ;;
            --manifest) TOOLS_ARGS+=(--manifest "${2:?}"); shift ;;
            --tool) TOOLS_ARGS+=("${2:?}"); shift ;;
            --update) TOOLS_ARGS+=(--update) ;;
            --no-docker) docker=0 ;;
            --no-project) noproject=1 ;;
            --no-cache) cache=0 ;;
            --no-token) token=0 ;;
            --no-home) home=0 ;;
            --kind) shift; kind=${1:-} ;;
            --flavor) shift; flavor=${1:-} ;;
            --release) shift; release=${1:-} ;;
            --legacy) legacy=1 ;;
            --nesting) nesting=1 ;;
            --cpu) shift; cpu=${1:-} ;;
            --memory) shift; mem=${1:-} ;;
            --disk) shift; disk=${1:-} ;;
            -*) die "알 수 없는 옵션: $1" ;;
            *) name=$1 ;;
        esac
        shift
    done
    [[ -n $mem ]] || mem=$(default_ct_mem)   # 호스트 RAM 에 맞춘 기본값(다른 호스트에서도 자동으로 따라감)
    # 종류는 필수·기본값 없음: 빠뜨리면 실패한다(VM 용 보안 가정이 컨테이너로 번지지 않게 — plan §15 조건 ①)
    case "$kind" in
        vm) ;;
        ct)
            # 필요한 도구를 같이 초기화: Docker 는 기본으로 nesting 을 켜고 만든 뒤 설치한다(--no-docker·매니페스트 override 로 끔)
            DOCKER_ARGS=()
            local _repo="" _man="" _i
            for ((_i = 0; _i < ${#TOOLS_ARGS[@]}; _i++)); do
                case ${TOOLS_ARGS[_i]} in
                    --from-repo) _repo=${TOOLS_ARGS[_i+1]}; DOCKER_ARGS+=(--from-repo "$_repo") ;;
                    --manifest) _man=${TOOLS_ARGS[_i+1]}; DOCKER_ARGS+=(--manifest "$_man") ;;
                    --update) DOCKER_ARGS+=(--update) ;;
                esac
            done
            [[ -z $_man && -n $_repo ]] && _man="$HOME/.config/sbox/manifests/$(basename "${_repo%/}").toml"
            EGRESS_MAN=$_man
            # 디스크 크기: --disk 가 없으면 매니페스트 [resources] disk(명시한 --disk 가 우선). 잘못된 값은 여기서 멈춘다
            if [[ -z $disk && -n $_man ]]; then
                disk=$(python3 "$SBOX_DIR/tools.py" resource "$_man" disk) || die "매니페스트 [resources] disk 값이 잘못됐습니다($_man)"
                [[ -z $disk ]] || say "디스크 한도 $disk (매니페스트 [resources] disk)"
            fi
            # 프로젝트(매니페스트) 없이는 송신 허용을 계산할 수 없다 — 조용히 전부 열리지 않게 명시적 선택과 확인을 요구한다
            if [[ -z $_man ]]; then
                ((noproject)) || die "프로젝트가 필요합니다: --from-repo <저장소> (또는 --manifest <파일>). 프로젝트 없이 만들려면 --no-project — 송신은 최소 세트(OS 저장소·Docker·GitHub·LLM API)만 열립니다"
                EGRESS_MINIMAL=1
                say "프로젝트 없음(--no-project): 송신 허용은 최소 세트(always+flavor)만 — 도구·프로젝트 도메인은 열리지 않습니다"
            fi
            if [[ $docker == auto ]]; then
                docker=1   # 기본 켬(늘 쓰는 도구) — 끄는 길은 --no-docker(이번 한 번) 또는 매니페스트 [override] docker = "no"(영구)
                local _rc=0
                python3 "$SBOX_DIR/dockerctl.py" wanted ${_man:+--manifest "$_man"} >/dev/null || _rc=$?
                ((_rc <= 1)) || die "매니페스트의 [override] docker 값이 잘못됐습니다($_man)"
                ((_rc == 0)) || { docker=0; say "매니페스트 [override] docker = \"no\" — Docker 를 설치하지 않습니다"; }
            fi
            ((docker)) && nesting=1
            DOCKER=$docker
            create_ct "$name" "$flavor" "$release" "$legacy" "$nesting" "$cpu" "$mem" "$token" "$disk"; return ;;
        "") die "--kind vm|ct 가 필요합니다(기본값 없음)" ;;
        *) die "알 수 없는 종류: $kind (vm|ct)" ;;
    esac
    ((${#TOOLS_ARGS[@]})) && die "--from-repo·--manifest·--tool·--update 는 ct(컨테이너) 전용입니다 — vm 은 nixos 설정으로 도구를 관리합니다"
    [[ -z $flavor || $flavor == nixos ]] || die "vm 종류는 nixos 만 구현돼 있습니다(받은 flavor: $flavor)"
    [[ -n $name ]] || name="sbox-vm-$(date +%y%m%d-%H%M)"
    check_name "$name"
    incus info "$GOLDEN_INST" >/dev/null 2>&1 || die "골든 $GOLDEN_INST 가 없습니다 — 먼저 'sboxctl golden'"
    incus info "$name" >/dev/null 2>&1 && die "$name 은 이미 있습니다"
    incus network show "$NETWORK" >/dev/null 2>&1 || die "브리지 $NETWORK 가 없습니다"

    say "생성: $name ← $GOLDEN_INST@$GOLDEN_SNAP (스냅샷 복제, vmx 마스킹 켬 = 중첩 가상화 기본 꺼짐)"
    # incus 클라이언트가 수십 분 멈춘 적이 있다(2026-11-22 네 번, 원인 미확인 — 새 이름으로도 재현) —
    # 시간 제한을 두고 실패하면 반쯤 만들어진 것을 지운 뒤 재시도한다.
    local _try _err
    for _try in 1 2 3; do
        if _err=$(timeout 180 incus copy "$GOLDEN_INST/$GOLDEN_SNAP" "$name" 2>&1 </dev/null); then break; fi
        say "incus copy 실패($_try/3): ${_err##*$'\n'}"
        incus delete -f "$name" >/dev/null 2>&1 || true
        sleep 10
        [[ $_try == 3 ]] && die "incus copy 3회 실패($name): ${_err##*$'\n'}"
    done
    incus config set "$name" raw.qemu="-cpu host,-vmx"
    incus config device get "$name" eth0 network 2>/dev/null | grep -qx "$NETWORK" || die "$name 의 eth0 가 $NETWORK 에 붙어 있지 않습니다"
    incus start "$name"
    wait_agent "$name"
    # 골든은 같은 호스트명·머신 ID 를 물려받는다 — 같은 시기에 여러 대를 띄워도 DHCP 는 MAC 으로 구분되므로 두고 간다.

    ((home)) && home_apply "$name"
    ((cache)) && cmd_cache "$name"
    ((token)) && cmd_token "$name"

    local ip
    ip=$(incus list "$name" -f json | python3 -c 'import sys,json
d=json.load(sys.stdin)[0]["state"]["network"]
print(" ".join(a["address"] for a in d.get("eth0",{}).get("addresses",[]) if a["family"]=="inet"))')
    audit info create "$name" "골든 $GOLDEN_INST@$GOLDEN_SNAP 에서 생성, $ip, vmx 마스킹 켬"
    say "완료: $name  ($ip)"
    say "Claude 는 VM 안에서: CLAUDE_CODE_OAUTH_TOKEN=\$(cat $TOKEN_PATH) claude"
}

cmd_bundle() {
    local name="" repo_path=""
    while (($#)); do
        case $1 in
            --repo) shift; repo_path=${1:-} ;;
            -*) die "알 수 없는 옵션: $1" ;;
            *) name=$1 ;;
        esac
        shift
    done
    check_name "$name"
    if [[ -z $repo_path ]]; then
        [[ $NAME_KIND == vm ]] || die "ct 종류는 --repo <컨테이너 안 저장소 경로> 가 필요합니다(예: /home/$VM_USER/proj)"
        repo_path=$VM_REPO
    fi
    [[ $(incus list "$name" -f csv -c s) == RUNNING ]] || die "$name 이 실행 중이 아니라 번들을 꺼낼 수 없습니다"
    vmu "$name" test -d "$repo_path/.git" || die "$repo_path 에 저장소가 없습니다"
    mkdir -p "$BUNDLE_DIR"
    local out
    out="$BUNDLE_DIR/$name-$(date +%y%m%d-%H%M%S).bundle"
    # 미커밋 변경은 번들에 안 들어간다 — 있으면 알린다(destroy 는 이것으로 거부)
    local dirty
    dirty=$(vmu "$name" git -C "$repo_path" status --porcelain 2>/dev/null | grep -Ev "$DIRTY_IGNORE" || true)
    if [[ -n $dirty ]]; then
        say "미커밋 변경 $(wc -l <<<"$dirty")건 — 번들에 들어가지 않습니다:"
        head -20 <<<"$dirty" | while IFS= read -r l; do printf '    %s\n' "$l"; done >&2
        SBOX_DIRTY=1
    fi
    vmu "$name" git -C "$repo_path" bundle create - --all >"$out" 2>/dev/null || { rm -f "$out"; die "번들 생성 실패"; }
    [[ -s $out ]] || { rm -f "$out"; die "번들이 비었습니다"; }
    (cd "$(dirname "$(readlink -f "$0")")/../.." && git bundle verify "$out" >/dev/null 2>&1) \
        || { say "경고: 호스트 저장소에서 verify 실패 — 번들은 남깁니다: $out"; }
    audit info bundle "$name" "$out"
    say "번들 저장: $out ($(du -h "$out" | cut -f1))"
    BUNDLE_OUT=$out
}

cmd_import() {
    local bundle=${1:-}
    [[ -r $bundle ]] || die "읽을 수 있는 번들 파일이 필요합니다: ${bundle:-(없음)}"
    local repo base vm
    repo=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
    base=$(basename "$bundle" .bundle)
    vm=${base%-[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]}
    [[ $vm =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "번들 이름에서 VM 이름을 알 수 없습니다($base)"
    git -C "$repo" bundle verify "$bundle" >/dev/null 2>&1 || die "번들 검증 실패 — 필요한 선행 커밋이 호스트 저장소에 없거나 파일이 깨졌습니다"
    # 별도 ref 로만 받는다: 호스트의 브랜치·작업 트리는 건드리지 않는다. VM 안 내용은 신뢰하지 않으므로 사람이 보고 cherry-pick/병합한다.
    git -C "$repo" fetch --quiet "$bundle" "refs/heads/*:refs/sbox/$vm/*" || die "fetch 실패"
    say "가져옴: refs/sbox/$vm/*  (호스트 작업 트리·브랜치는 그대로)"
    local ref
    while IFS= read -r ref; do
        say "── $ref : 호스트 HEAD 에 없는 커밋"
        git -C "$repo" log --oneline --no-decorate "HEAD..$ref" | head -30 >&2
    done < <(git -C "$repo" for-each-ref --format='%(refname)' "refs/sbox/$vm/")
    say "검토: git log HEAD..refs/sbox/$vm/<브랜치> · 반영: git cherry-pick / git merge --no-ff (사람이 확인한 뒤)"
    audit info import "$vm" "$bundle → refs/sbox/$vm/*"
}

cmd_destroy() {
    local name="" force=0 discard=0 repo_path="" nobundle=0
    while (($#)); do
        case $1 in
            --repo) shift; repo_path=${1:-} ;;
            --no-bundle) nobundle=1 ;;
            --force) force=1 ;;
            --discard-dirty) discard=1 ;;
            -*) die "알 수 없는 옵션: $1" ;;
            *) name=$1 ;;
        esac
        shift
    done
    check_name "$name"
    incus info "$name" >/dev/null 2>&1 || die "$name 이 없습니다"
    SBOX_DIRTY=0
    if ((force)); then
        say "--force: 번들 없이 지웁니다"
    elif ((nobundle)); then
        say "--no-bundle: 번들 없이 지웁니다(저장소가 없거나 필요 없다고 확인한 경우)"
        audit info destroy-nobundle "$name" "번들 없이 삭제 요청"
    else
        if [[ $NAME_KIND == ct && -z $repo_path ]]; then
            die "ct 종류는 --repo <컨테이너 안 저장소 경로>(번들을 먼저 꺼냄) 또는 --no-bundle 이 필요합니다"
        fi
        if [[ -n $repo_path ]]; then cmd_bundle "$name" --repo "$repo_path"; else cmd_bundle "$name"; fi
        if ((SBOX_DIRTY)) && ((!discard)); then
            die "미커밋 변경이 있어 지우지 않습니다 — VM 안에서 커밋 후 다시 하거나 --discard-dirty (번들은 $BUNDLE_OUT 에 저장됨)"
        fi
    fi
    incus delete -f "$name"
    egress_detach "$name"
    if ((force)); then
        audit critical destroy "$name" "--force: 번들 없이 삭제"
    else
        audit info destroy "$name" "번들 ${BUNDLE_OUT:-없음} 저장 후 삭제"
    fi
    say "삭제 완료: $name"
}

# 도구 층 v1 (plan dev-sandbox-pilot §29, S5·S34): 호스트가 공식 파일을 받아 sha256 검증 → 컨테이너에 읽기 전용으로만 마운트.
# 사용: tools NAME [--from-repo DIR | --manifest FILE] [--update] [TOOL=SPEC ...]   (node·claude)
#  --from-repo/--manifest 는 ~/.config/sbox/manifests/<프로젝트>.toml 을 만들거나 갱신하고 **정확한 버전을 [resolved] 에 고정**한다
#  (22 같은 느슨한 스펙이 나중에 다른 패치로 조용히 바뀌지 않음). 다시 해석하려면 --update. TOOL=SPEC 은 매니페스트에 [override] 로 기록된다.
cmd_tools() {
    local name=${1:-}; shift || true
    [[ -n $name ]] || die "사용법: sboxctl tools NAME [--from-repo DIR | --manifest FILE] [--update] [TOOL[=SPEC] ...]  (도구 목록: python3 core/sbox/tools.py catalog)"
    check_name "$name"
    [[ $NAME_KIND == ct ]] || die "도구 층은 컨테이너(ct)만 지원합니다"
    incus info "$name" >/dev/null 2>&1 </dev/null || die "$name 이 없습니다"
    local -a pargs=() inline=()
    local a
    while (($#)); do
        a=$1; shift
        case $a in
            --from-repo) pargs+=(--repo "${1:?}"); shift ;;
            --manifest) pargs+=(--manifest "${1:?}"); shift ;;
            --update) pargs+=(--update) ;;
            *) inline+=("$a"); pargs+=(--tool "$a") ;;   # TOOL=SPEC, 또는 de 도구는 이름만(최신)
        esac
    done
    local lines k spec ver src how
    if printf '%s\n' "${pargs[@]}" | grep -qE '^--(repo|manifest)$'; then
        lines=$(python3 "$SBOX_DIR/tools.py" plan "${pargs[@]}" | python3 -c 'import sys,json
d=json.load(sys.stdin)
if d["manifest"]: print("매니페스트:", d["manifest"], file=sys.stderr)
for u in d.get("unsupported",[]): print("경고: 도구 층 미지원 — 수동 필요:", u, file=sys.stderr)
for k,v in d["tools"].items(): print("\x1f".join([k,v["spec"],v["version"],v["source"],v["how"]]))') || die "매니페스트 계획 실패"
    else
        ((${#inline[@]})) || die "설치할 도구가 없습니다(--from-repo·--manifest 또는 TOOL[=SPEC] 필요)"
        lines=""
        for a in "${inline[@]}"; do
            k=${a%%=*}; spec=""; [[ $a == *=* ]] && spec=${a#*=}
            ver=$(python3 "$SBOX_DIR/tools.py" resolve "$k" $spec) || die "$k ${spec:-(최신)} 버전 해석 실패"
            lines+="$k"$'\x1f'"${spec:-(기본 채널)}"$'\x1f'"$ver"$'\x1f'"인자"$'\x1f'"일회성"$'\n'
        done
    fi
    local dir dev role links d
    while IFS=$'\x1f' read -r k spec ver src how; do
        [[ -n $k ]] || continue
        links=$(python3 "$SBOX_DIR/tools.py" links "$k") || die "$k 는 카탈로그에 없는 도구입니다"
        say "도구: $k $spec → $ver ($src, $how)"
        dir=$(python3 "$SBOX_DIR/tools.py" fetch "$k" "$ver") || die "$k $ver 받기·검증 실패"
        dev="tools-$k-${ver//./_}"
        # 컨테이너 하나 = 도구마다 버전 한 벌 — 같은 도구의 다른 버전 장치는 뺀다
        for d in $(incus config device list "$name" </dev/null | grep "^tools-$k-" || true); do
            [[ $d == "$dev" ]] || incus config device remove "$name" "$d" </dev/null >/dev/null || die "옛 장치 제거 실패($d)"
        done
        if ! incus config device show "$name" </dev/null | grep -q "^$dev:"; then
            incus config device add "$name" "$dev" disk source="$dir" path="/opt/tools/$k/$ver" readonly=true </dev/null >/dev/null \
                || die "읽기 전용 장치 추가 실패($dev)"
        fi
        # /usr/local/bin 링크 — 이름과 대상은 카탈로그(links)가 정한다
        python3 -c 'import sys,json
k,v=sys.argv[1],sys.argv[2]
for n,rel in json.loads(sys.argv[3]).items():
    dst = n if n.startswith("/") else "/usr/local/bin/"+n   # 절대 경로 이름은 그대로(예: docker CLI 플러그인 폴더)
    print("mkdir -p $(dirname %s)" % dst); print(f"ln -sfn /opt/tools/{k}/{v}/{rel} {dst}")' "$k" "$ver" "$links" \
            | incus exec "$name" --env "PATH=$CT_PATH" -- sh || die "/usr/local/bin 연결 실패"
        audit info tools "$name" "$k $ver 읽기 전용 마운트(스펙 $spec, $src, $how)"
        say "완료: $k $ver — /opt/tools/$k/$ver (읽기 전용), /usr/local/bin 에 연결"
        # de(개발환경) 도구는 최신 채널을 따라감 — 어느 인스턴스도 쓰지 않는 옛 버전은 호스트 캐시에서 정리한다
        role=$(python3 "$SBOX_DIR/tools.py" catalog | python3 -c 'import sys,json;print(json.load(sys.stdin)["'"$k"'"]["role"])')
        if [[ $role == de ]]; then
            local gone
            gone=$(incus list -f json </dev/null | python3 -c 'import sys,json
for i in json.load(sys.stdin):
    for d in (i.get("devices") or {}).values():
        if d.get("type")=="disk" and d.get("source"): print(d["source"])' | python3 "$SBOX_DIR/tools.py" prune "$k" --keep "$ver")
            [[ -z $gone ]] || say "정리: 쓰이지 않는 옛 $k 버전 삭제 — $gone"
        fi
    done <<<"$lines"
}

# ct 안 rootless Docker (plan dev-sandbox-pilot §29-15, S53·S19·S55). 호스트는 Docker 저장소에서 온 것을 실행하지 않는다 —
# dockerctl.py 가 키(고정 보관·독립 출처 교차 확인)와 설치 버전(쿨다운 적용)을 정해 주면, 이 함수가 키·저장소 파일을 ct 에 써 넣고 ct 안 root 의 apt 가 설치한다(서명은 apt 가 고정 키로 검증).
# 사용: docker NAME [--from-repo DIR | --manifest FILE] [--update] [--no-compose]   — ct 전용, 만들 때 --nesting 이 있어야 한다
cmd_docker() {
    local name=${1:-}; shift || true
    [[ -n $name ]] || die "사용법: sboxctl docker NAME [--from-repo DIR | --manifest FILE] [--update] [--no-compose]"
    check_name "$name"
    [[ $NAME_KIND == ct ]] || die "Docker 설치는 컨테이너(ct)만 지원합니다(vm 은 nixos 설정으로)"
    incus info "$name" >/dev/null 2>&1 </dev/null || die "$name 이 없습니다"
    local manifest="" update="" compose=1
    while (($#)); do
        case $1 in
            --from-repo) manifest="$HOME/.config/sbox/manifests/$(basename "${2:?}" | sed 's#/*$##').toml"; shift ;;
            --manifest) manifest=${2:?}; shift ;;
            --update) update=--update ;;
            --no-compose) compose=0 ;;
            *) die "docker: 알 수 없는 인자 $1" ;;
        esac
        shift
    done
    [[ $(incus config get "$name" security.nesting </dev/null) == true ]] \
        || die "$name 은 security.nesting 이 꺼져 있습니다 — rootless Docker 에 필요합니다(만들 때 --nesting). 이 컨테이너를 지우고 --nesting 으로 다시 만드세요"
    local osinfo distro codename arch
    osinfo=$(incus exec "$name" --env "PATH=$CT_PATH" -- sh -c '. /etc/os-release; printf "%s %s %s" "$ID" "$VERSION_CODENAME" "$(dpkg --print-architecture)"' </dev/null) \
        || die "$name 의 OS 정보를 읽지 못했습니다"
    read -r distro codename arch <<<"$osinfo"
    # 호스트에서: 키 고정·교차 확인 + 쿨다운을 적용한 설치 버전 선택(+ 매니페스트에 고정)
    local plan_json
    plan_json=$(python3 "$SBOX_DIR/dockerctl.py" plan --distro "$distro" --codename "$codename" --arch "$arch" ${manifest:+--manifest "$manifest"} $update) || die "Docker 설치 계획 실패"
    local key_file sources dv cv
    key_file=$(printf '%s' "$plan_json" | python3 -c 'import sys,json;print(json.load(sys.stdin)["key_file"])')
    sources=$(printf '%s' "$plan_json" | python3 -c 'import sys,json;print(json.load(sys.stdin)["sources"],end="")')
    dv=$(printf '%s' "$plan_json" | python3 -c 'import sys,json;print(json.load(sys.stdin)["versions"]["docker-ce"])')
    cv=$(printf '%s' "$plan_json" | python3 -c 'import sys,json;print(json.load(sys.stdin)["versions"]["containerd.io"])')
    printf '%s' "$plan_json" | python3 -c 'import sys,json
for n in json.load(sys.stdin)["notes"]: print("sbox: "+n, file=sys.stderr)'
    say "Docker: docker-ce $dv, containerd.io $cv ($distro $codename) → $name"
    [[ -z $manifest ]] && say "알림: --from-repo·--manifest 가 없어 이 버전이 어디에도 고정되지 않습니다(같은 매니페스트로 다시 만들어도 같은 버전을 보장하려면 지정하세요)"
    local ex=(incus exec "$name" --env "PATH=$CT_PATH" --env DEBIAN_FRONTEND=noninteractive --)
    # 1) https 저장소를 읽을 최소 부품 → 키·저장소 파일(호스트가 만든 것) 기록 → 이미 고정돼 있으면 풀었다가 다시 고정
    "${ex[@]}" sh -ec 'apt-mark unhold docker-ce docker-ce-cli docker-ce-rootless-extras containerd.io >/dev/null 2>&1 || true
        apt-get update -qq
        apt-get install -y -qq --no-install-recommends ca-certificates uidmap dbus-user-session >/dev/null' </dev/null || die "기본 부품 설치 실패"
    incus file push "$key_file" "$name/etc/apt/keyrings/docker.asc" --create-dirs --uid 0 --gid 0 --mode 0644 </dev/null >/dev/null || die "키 파일 기록 실패"
    printf '%s' "$sources" | "${ex[@]}" sh -c 'cat > /etc/apt/sources.list.d/docker.sources' || die "저장소 파일 기록 실패"
    # 2) 정확한 버전으로 설치(추천 패키지 제외 — apt 의 compose 플러그인이 딸려 오지 않게), 고정, rootful 서비스 끄기
    "${ex[@]}" sh -ec 'apt-get update -qq
        apt-get install -y -qq --no-install-recommends --allow-downgrades "docker-ce=$1" "docker-ce-cli=$1" "docker-ce-rootless-extras=$1" "containerd.io=$2" >/dev/null
        apt-mark hold docker-ce docker-ce-cli docker-ce-rootless-extras containerd.io >/dev/null
        systemctl disable --now docker.service docker.socket >/dev/null 2>&1 || true
        loginctl enable-linger sbox' _ "$dv" "$cv" </dev/null \
        || die "Docker 패키지 설치 실패($name) — 시도한 버전 docker-ce $dv, containerd.io $cv"
    # 3) 사용자 sbox 의 rootless 서비스(사용자 systemd 가 올라올 때까지 기다림)
    "${ex[@]}" sh -c 'U=$(id -u sbox); for _ in $(seq 1 30); do [ -S /run/user/$U/bus ] && exit 0; sleep 1; done; exit 1' </dev/null || die "sbox 사용자 세션이 올라오지 않았습니다(linger)"
    "${ex[@]}" su -s /bin/sh sbox -c 'U=$(id -u); export XDG_RUNTIME_DIR=/run/user/$U DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$U/bus HOME=/home/sbox PATH=/usr/bin:/bin:/usr/sbin:/sbin
        dockerd-rootless-setuptool.sh install >/dev/null 2>&1 && systemctl --user is-active docker >/dev/null' </dev/null || die "rootless 설정 실패 — ct 안에서 'su - sbox -c dockerd-rootless-setuptool.sh install' 출력을 보세요"
    # 4) Compose 는 도구 층(Sigstore 검증) 것을 쓴다 — apt 의 compose 플러그인은 설치하지 않음
    if ((compose)); then
        incus exec "$name" --env "PATH=$CT_PATH" -- test -e /usr/local/lib/docker/cli-plugins/docker-compose </dev/null 2>/dev/null \
            || { if [[ -n $manifest && -f $manifest ]]; then cmd_tools "$name" --manifest "$manifest" compose=latest; else cmd_tools "$name" compose=latest; fi; } || say "경고: 도구 층 Compose 연결 실패 — 'sboxctl tools $name compose=latest' 로 다시 시도하세요"
    fi
    # 5) buildx(도구 층, Sigstore 검증) — 레거시 빌더는 중간·미태그 이미지를 남겨 genple 에서 회수 가능한 낭비가 80% 였다(pilot §29-41)
    if ((compose)); then
        incus exec "$name" --env "PATH=$CT_PATH" -- test -e /usr/local/lib/docker/cli-plugins/docker-buildx </dev/null 2>/dev/null \
            || { if [[ -n $manifest && -f $manifest ]]; then cmd_tools "$name" --manifest "$manifest" buildx=latest; else cmd_tools "$name" buildx=latest; fi; } || say "경고: 도구 층 buildx 연결 실패 — 'sboxctl tools $name buildx=latest' 로 다시 시도하세요"
    fi
    # 6) 특권 포트(80·443 게시): ct 의 net 네임스페이스 sysctl 이라 호스트에는 영향 없음. rootless Docker 가 -p 80:… 를 열려면 필요(80 이상만 허용 — 22 같은 낮은 포트는 계속 특권).
    "${ex[@]}" sh -ec 'printf "net.ipv4.ip_unprivileged_port_start = 80\n" > /etc/sysctl.d/99-sbox-ports.conf; sysctl -q -p /etc/sysctl.d/99-sbox-ports.conf' </dev/null \
        || say "경고: ct 안 net.ipv4.ip_unprivileged_port_start 설정 실패 — 80·443 게시가 거부될 수 있습니다"
    # 7) Docker 정리 자동화(ct 안, sbox 사용자 systemd): 빌드 캐시는 데몬이 한도(4GB)로 스스로 정리, 쓰이지 않는 미태그 이미지·72시간 넘은 중단 컨테이너는 매일 정리. 볼륨·태그된 이미지는 건드리지 않는다.
    "${ex[@]}" sh -ec 'd=/home/sbox/.config/docker; mkdir -p $d /home/sbox/.config/systemd/user
        cat > $d/daemon.json <<EOF2
{"builder": {"gc": {"enabled": true, "defaultKeepStorage": "4GB"}}}
EOF2
        cat > /home/sbox/.config/systemd/user/sbox-docker-prune.service <<EOF2
[Unit]
Description=sbox: 쓰이지 않는 미태그 이미지·오래된 중단 컨테이너 정리(볼륨·태그된 이미지는 유지)
[Service]
Type=oneshot
Nice=19
Environment=DOCKER_HOST=unix://%t/docker.sock
ExecStart=/usr/bin/docker container prune -f --filter until=72h
ExecStart=/usr/bin/docker image prune -f
EOF2
        cat > /home/sbox/.config/systemd/user/sbox-docker-prune.timer <<EOF2
[Unit]
Description=sbox: Docker 정리(매일)
[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true
[Install]
WantedBy=timers.target
EOF2
        chown -R sbox: /home/sbox/.config' </dev/null || die "Docker 정리 설정 기록 실패"
    "${ex[@]}" su -s /bin/sh sbox -c 'U=$(id -u); export XDG_RUNTIME_DIR=/run/user/$U DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$U/bus HOME=/home/sbox
        systemctl --user daemon-reload && systemctl --user enable --now sbox-docker-prune.timer >/dev/null && systemctl --user restart docker' </dev/null \
        || say "경고: Docker 정리 타이머·gc 설정 적용 실패 — ct 안에서 'systemctl --user status sbox-docker-prune.timer' 를 보세요"
    audit info docker "$name" "rootless Docker: docker-ce $dv, containerd.io $cv (${distro} ${codename}), 키 고정 ${key_file##*/}, apt-mark hold"
    say "완료: $name — rootless Docker(docker-ce $dv). sbox 사용자로 'docker info'(Security Options: rootless). 올리려면 'sboxctl docker $name --update'(쿨다운 다시 적용)"
}

# 안에서 LLM 코딩 에이전트 대화형 세션을 tmux 로 시작한다(vm·ct 공통) — 에이전트별 정의는 core/sbox/llm.toml(plan dev-sandbox-pilot §29-10).
# 첫 실행 안내를 설정 병합으로 미리 처리한다(claude: 테마·보안 안내·폴더 신뢰·bypass 경고 — §23 S42).
#  vm: 에이전트는 홈 설정이 깐 것을 쓰고 tmux 는 nix shell 로.  ct: tmux 는 root 가 apt 로, 에이전트는 도구 층(호스트 검증)으로 설치.
# 사용: llm AGENT NAME [--dir 폴더] [--bypass] [--attach] [--version V] [--update]   (--bypass: 권한 확인 생략 모드 — 일회용 환경 안에서만)
agent_get() { python3 "$SBOX_DIR/llm.py" get "$1" "$2"; }
llm_tmux() { # llm_tmux NAME ARGS… — 종류에 맞게 tmux 를 sbox 사용자로 실행
    local name=$1; shift
    if [[ $NAME_KIND == vm ]]; then vmu "$name" nix shell nixpkgs#tmux -c tmux "$@"; else vmu "$name" tmux "$@"; fi
}
cmd_llm() {
    local agent=${1:-}; shift || true
    [[ -n $agent ]] || die "사용법: sboxctl llm AGENT NAME [--dir 폴더] [--bypass] [--attach] [--version V] [--update]  (정의된 에이전트: $(python3 "$SBOX_DIR/llm.py" list | cut -f1 | tr '\n' ' '))"
    local tool cmd bypass_flags token_env token_path envs first_run patterns
    tool=$(agent_get "$agent" tool) || exit 1
    cmd=$(agent_get "$agent" cmd) || exit 1
    bypass_flags=$(agent_get "$agent" bypass_flags 2>/dev/null || true)
    token_env=$(agent_get "$agent" token_env) || exit 1
    token_path=$(agent_get "$agent" token_path) || exit 1
    envs=$(agent_get "$agent" env 2>/dev/null || true)
    first_run=$(agent_get "$agent" first_run 2>/dev/null || echo none)
    patterns=$(agent_get "$agent" dialog_patterns 2>/dev/null || true)
    local name=${1:-}; shift || true
    [[ -n $name ]] || die "사용법: sboxctl llm $agent NAME [--dir 폴더] [--bypass] [--attach] [--version V] [--update]"
    local dir="$VM_HOME/work" bypass=0 attach=0 ver_req="" update=0
    while (($#)); do
        case $1 in
            --dir) dir=${2:?}; shift ;;
            --bypass) bypass=1 ;;
            --attach) attach=1 ;;
            --version|--claude-version) ver_req=${2:?}; shift ;;
            --update) update=1 ;;
            *) die "알 수 없는 인자: $1" ;;
        esac
        shift
    done
    check_name "$name"
    [[ $dir == /home/$VM_USER/* ]] || die "--dir 은 안쪽 /home/$VM_USER/ 아래여야 합니다(받은 값: $dir)"
    ((bypass)) && [[ -z $bypass_flags ]] && die "$agent 정의에 bypass_flags 가 없어 --bypass 를 쓸 수 없습니다"
    vmu "$name" test -s "$token_path" </dev/null || die "토큰이 없습니다 — 'sboxctl token $name $agent' 으로 주입하세요"
    vmu "$name" mkdir -p "$dir" </dev/null
    local pre="" e
    for e in $envs; do pre+="$e "; done
    # S64: 이 ct 에 자리표시자가 등록돼 있으면 broker 의 키 주입 어댑터로 보낸다(토큰은 자리표시자, 진짜 값은 broker 에만). 프록시 환경변수가 이 평문 요청을 가로채지 않게 NO_PROXY.
    if [[ $agent == claude ]] && incus info "$BROKER" >/dev/null 2>&1 </dev/null \
        && [[ -n $(python3 "$SBOX_DIR/egress.py" inject-get --state "$EGRESS_STATE" --name "$name" 2>/dev/null) ]]; then
        local _bip; _bip=$(ct_ip "$BROKER")
        pre+="ANTHROPIC_BASE_URL=http://$_bip:$BROKER_INJECT_PORT NO_PROXY=$_bip no_proxy=$_bip "
    fi   # 읽기 전용 마운트라 자동 갱신은 못 하고 실패 메시지만 낸다 — 정의의 env 로 끈다
    if [[ $NAME_KIND == ct ]]; then
        vmx "$name" sh -c 'command -v tmux >/dev/null 2>&1 || { apt-get update -qq >/dev/null && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq tmux >/dev/null; }' </dev/null \
            || die "tmux 설치 실패(컨테이너 안 apt)"
        # 에이전트는 개발환경(de) 도구 — 호스트가 서명 검증해 읽기 전용 마운트. 최신 채널(카탈로그 기본, claude 는 stable ≈ 1주 지연 — 사용자 방침):
        # 없을 때 또는 --update 일 때 받고 쓰이지 않는 옛 버전은 정리한다. 특정 버전이 필요하면 --version.
        if ((update)) || ! incus exec "$name" --env "PATH=$CT_PATH" -- sh -c "test -x /usr/local/bin/$cmd" </dev/null; then
            cmd_tools "$name" "$tool${ver_req:+=$ver_req}" || die "도구 층 $tool 설치 실패"
        fi
    else
        vmu "$name" sh -c "command -v $cmd >/dev/null 2>&1 || test -x \"\$HOME/.nix-profile/bin/$cmd\"" </dev/null \
            || die "VM 에 $cmd 가 없습니다 — $agent 의 VM 설치 방식은 아직 정의돼 있지 않습니다(claude 는 골든의 홈 설정이 설치)"
    fi
    if [[ $first_run == claude ]]; then
        # ⑱ 업데이트 제동(plan dev-sandbox-pilot §29-50·51): 관리 설정(root 소유 644 — 에이전트 사용자가 못 고침)의 permissions.ask 로
        # 의존성 설치·갱신 명령은 bypass 모드에서도 사람 확인을 거치게 한다(프로젝트 allow 로 못 풂 — 실제 ct 시험). 우회 변형(sh -c 등)은 못 막는 속도 제동이다.
        # VM 은 NixOS 라 /etc 선언 방식이 다르고 미설계 — ct 만 적용한다.
        if [[ $NAME_KIND == ct ]]; then
            incus exec "$name" -- mkdir -p /etc/claude-code </dev/null \
                && { _ms=$(mktemp); managed_settings_file "$name" "$_ms" && incus file push "$_ms" "$name/etc/claude-code/managed-settings.json" --uid 0 --gid 0 --mode 0644; _rc=$?; rm -f "$_ms"; ((_rc == 0)); } \
                && incus file push "$SBOX_DIR/claude-managed-mcp.json" "$name/etc/claude-code/managed-mcp.json" --uid 0 --gid 0 --mode 0644 \
                || die "관리 설정(업데이트 제동·MCP 차단) 설치 실패"   # managed-mcp.json = {} : 프로젝트 .mcp.json 의 MCP 서버(예: poriring 의 npx playwright@latest)를 막는다(pilot §29-83·85)
        else
            say "참고: VM 에는 의존성 갱신 제동(관리 설정)이 아직 적용되지 않습니다(ct 만)"
        fi
    fi
    if [[ $first_run == claude ]]; then
        # 첫 실행 설정 병합(기존 값은 보존): ~/.claude.json 의 온보딩 완료·폴더 신뢰, ~/.claude/settings.json 의 테마·(bypass 면) 경고 생략
        local f
        for f in .claude.json .claude/settings.json; do
            { vmu "$name" sh -c "cat \"\$HOME/$f\" 2>/dev/null || echo '{}'" </dev/null \
                | python3 -c 'import sys,json
f,d,b=sys.argv[1],sys.argv[2],sys.argv[3]=="1"
try: j=json.load(sys.stdin)
except ValueError: j={}
if f==".claude.json":
    j["hasCompletedOnboarding"]=True
    j.setdefault("projects",{}).setdefault(d,{})["hasTrustDialogAccepted"]=True
else:
    j.setdefault("theme","auto")
    if b: j["skipDangerousModePermissionPrompt"]=True
print(json.dumps(j))' "$f" "$dir" "$bypass" \
                | vmu "$name" sh -c "umask 077; mkdir -p \"\$HOME/.claude\"; cat > \"\$HOME/$f.new\" && mv \"\$HOME/$f.new\" \"\$HOME/$f\""; } \
                || die "$f 설정 병합 실패"
        done
    fi
    local flags=""; ((bypass)) && flags=$bypass_flags
    local start_script='dir=$1; tok=$2; flags=$3; pre=$4; tenv=$5; cmd=$6; sess=$7
tmux has-session -t "$sess" 2>/dev/null && { echo "이미 실행 중"; exit 0; }
cd "$dir" || exit 1
tmux new-session -d -s "$sess" -x 200 -y 50 "${pre}${tenv}=\$(cat $tok) exec $cmd $flags"
echo "시작함"'
    local out
    if [[ $NAME_KIND == vm ]]; then
        out=$(vmu "$name" nix shell nixpkgs#tmux -c sh -c "$start_script" sh "$dir" "$token_path" "$flags" "$pre" "$token_env" "$cmd" "$agent") || die "tmux 세션 시작 실패"
    else
        out=$(vmu "$name" sh -c "$start_script" sh "$dir" "$token_path" "$flags" "$pre" "$token_env" "$cmd" "$agent") || die "tmux 세션 시작 실패"
    fi
    audit info llm "$name" "$agent tmux 세션: $out (dir $dir, bypass=$bypass)"
    # 첫 실행 안내 화면이 남아 있으면(에이전트 버전이 바뀌어 설정 키·문구가 달라졌을 수 있음) 알린다 — 안 알리면 사람이 붙었을 때 처음 알게 된다
    if [[ $out == 시작함 && -n $patterns ]]; then
        sleep 12
        local pane
        pane=$(llm_tmux "$name" capture-pane -p -t "$agent" </dev/null 2>/dev/null || true)
        if grep -qiE "$patterns" <<<"$pane"; then
            audit critical llm "$name" "$agent 첫 실행 안내 화면이 남아 있음 — 버전 변화로 설정 병합 키가 어긋났을 수 있음"
            say "경고: $agent 첫 실행 안내 화면이 남아 있습니다(설정 병합 키가 이 버전과 어긋났을 수 있음) — 붙어서 넘기고 core/scripts/sboxctl·core/sbox/llm.toml 을 확인하세요"
        fi
    fi
    local ver
    ver=$(vmu "$name" sh -c "PATH=\"\$HOME/.nix-profile/bin:\$PATH\"; $(agent_get "$agent" version_cmd 2>/dev/null || echo "$cmd --version") 2>/dev/null | head -1" </dev/null 2>/dev/null || true)
    say "$agent 세션 $out${ver:+ ($ver)} — 붙기: sboxctl llm $agent $name --attach  (떼기: Ctrl-b d)"
    if ((attach)); then
        llm_tmux "$name" attach -t "$agent"
    fi
}


cmd_skills() { # cmd_skills NAME add SKILL… | list | clear — 호스트의 donghans-* 스킬(nix store 의 해시 고정 경로)을 ct 의 **관리 스킬 경로**에 읽기 전용으로 마운트한다(R8, pilot §29-86)
    local name=${1:-} sub=${2:-}; shift 2 2>/dev/null || true
    check_name "$name"
    [[ $NAME_KIND == ct ]] || die "스킬 마운트는 ct 전용입니다"
    case $sub in
        add)
            (($#)) || die "사용법: sboxctl skills NAME add donghans-스킬이름…"
            local sk src
            for sk in "$@"; do
                if [[ $sk =~ ^sbox-[a-z0-9-]+$ ]]; then   # sbox 전용 스킬: 저장소(core/sbox/skills)의 사본을 nix store 에 넣어(내용 해시 경로) 마운트한다 — 호스트 스킬을 그대로 쓰지 않음
                    [[ -f $SBOX_DIR/skills/$sk/SKILL.md ]] || die "$SBOX_DIR/skills/$sk/SKILL.md 가 없습니다"
                    src=$(nix-store --add "$SBOX_DIR/skills/$sk") || die "$sk 를 nix store 에 넣지 못했습니다"
                elif [[ $sk =~ ^donghans-[a-z0-9-]+$ ]]; then
                    src=$(readlink -f "$HOME/.claude/skills/$sk") || die "$sk 를 찾지 못했습니다"
                else
                    die "스킬 이름은 sbox-*(저장소 core/sbox/skills) 또는 donghans-* 만 허용합니다(받은 값: $sk)"
                fi
                [[ -f $src/SKILL.md ]] || die "$src/SKILL.md 가 없습니다"
                [[ $src == /nix/store/* ]] || die "$sk 는 nix store 경로가 아니라(해시 고정 아님) 마운트를 거부합니다: $src"
                incus config device remove "$name" "sbox-skill-$sk" </dev/null >/dev/null 2>&1 || true
                incus config device add "$name" "sbox-skill-$sk" disk source="$src" path="/etc/claude-code/.claude/skills/$sk" readonly=true </dev/null >/dev/null \
                    || die "$sk 마운트 실패"
                audit info skills "$name" "스킬 읽기 전용 마운트: $sk ($src)"
                say "마운트: $sk → /etc/claude-code/.claude/skills/$sk (읽기 전용, $src)"
            done ;;
        list)
            incus config device list "$name" </dev/null | grep '^sbox-skill-' | sed 's/^sbox-skill-/  /' || say "  (마운트된 스킬 없음)" ;;
        clear)
            local d
            for d in $(incus config device list "$name" </dev/null | grep '^sbox-skill-'); do incus config device remove "$name" "$d" </dev/null >/dev/null; say "제거: $d"; done
            audit info skills "$name" "스킬 마운트 전부 제거" ;;
        *) die "사용법: sboxctl skills NAME add SKILL…|list|clear" ;;
    esac
}

managed_settings_file() { # managed_settings_file NAME OUT — 저장소의 관리 설정(⑱ 업데이트 제동 등)을 OUT 에 만든다. 이 ct 에 관문이 설치돼 있으면 env.CLAUDE_CODE_SHELL 을 더한다(sboxctl llm 이 매번 덮어써도 관문 설정이 지워지지 않게)
    local name=$1 out=$2
    if incus exec "$name" -- test -x /usr/local/bin/sbox-gate-bash </dev/null 2>/dev/null; then
        python3 "$SBOX_DIR/gate_setup.py" merge < "$SBOX_DIR/claude-managed-settings.json" > "$out"
    else
        cp "$SBOX_DIR/claude-managed-settings.json" "$out"
    fi
}

cmd_gate() { # cmd_gate NAME [--manifest F] [--off] [--status] — ct 의 Bash 도구를 **명령 관문 셸**(sbox-gate-bash)로 고정한다(S3, plan sbox-project-policy §4-2c-2 L2)
    local name=${1:-}; shift || true
    check_name "$name"
    [[ $NAME_KIND == ct ]] || die "gate 는 ct 전용입니다"
    local man="" off=0 status=0
    while (($#)); do
        case $1 in
            --manifest) man=${2:?}; shift ;;
            --off) off=1 ;;
            --status) status=1 ;;
            *) die "알 수 없는 인자: $1" ;;
        esac
        shift
    done
    incus info "$name" </dev/null 2>/dev/null | grep -q '^Status: RUNNING' || die "$name 가 실행 중이 아닙니다(incus start)"
    if ((status)); then
        python3 "$SBOX_DIR/gate_canary.py" "$name"; return $?
    fi
    local tmp; tmp=$(mktemp -d)
    incus exec "$name" -- mkdir -p /etc/claude-code /etc/sbox </dev/null || { rm -rf "$tmp"; die "ct 안 폴더 준비 실패"; }
    if ((off)); then
        # 관문을 끈다: 관리 설정을 저장소 기본(env 없음)으로 되돌리고 설치 파일을 지운다
        cp "$SBOX_DIR/claude-managed-settings.json" "$tmp/m.json"
        incus file push "$tmp/m.json" "$name/etc/claude-code/managed-settings.json" --uid 0 --gid 0 --mode 0644 </dev/null >/dev/null || { rm -rf "$tmp"; die "관리 설정 되돌리기 실패"; }
        incus exec "$name" -- sh -c 'rm -f /usr/local/bin/sbox-gate-bash /etc/sbox/gate.json' </dev/null
        rm -rf "$tmp"
        audit info gate "$name" "관문 제거(관리 설정 env 되돌림)"; say "관문을 껐습니다: $name — 에이전트의 Bash 가 다시 제한 없이 동작합니다(새 세션부터)"; return 0
    fi
    [[ -n $man ]] || man=$(incus config get "$name" user.sbox.manifest </dev/null 2>/dev/null || true)
    incus exec "$name" -- test -x /usr/bin/python3 </dev/null || { rm -rf "$tmp"; die "ct 안 python3 가 없습니다(먼저 'sboxctl taskd $name' 이 설치합니다)"; }
    # 1) 관문 프로그램(root 소유 755)과 설정(매니페스트 [gate] direct, 없으면 기본값)
    incus file push "$SBOX_DIR/gate.py" "$name/usr/local/bin/sbox-gate-bash" --uid 0 --gid 0 --mode 0755 </dev/null >/dev/null || { rm -rf "$tmp"; die "관문 설치 실패"; }
    if [[ -n $man && -f $man ]]; then
        python3 "$SBOX_DIR/tasks.py" gate-direct --manifest "$man" > "$tmp/gd.json" || { rm -rf "$tmp"; die "[gate] 검증 실패"; }
        if [[ $(cat "$tmp/gd.json") != "{}" ]]; then
            incus file push "$tmp/gd.json" "$name/etc/sbox/gate.json" --uid 0 --gid 0 --mode 0644 </dev/null >/dev/null || { rm -rf "$tmp"; die "gate.json 설치 실패"; }
        else
            incus exec "$name" -- rm -f /etc/sbox/gate.json </dev/null
        fi
    fi
    # 2) 관리 설정(root 소유 644 — 에이전트가 못 고침)에 env.CLAUDE_CODE_SHELL 고정
    managed_settings_file "$name" "$tmp/m.json"            # 관문 파일을 방금 설치했으므로 병합본이 만들어진다
    incus file push "$tmp/m.json" "$name/etc/claude-code/managed-settings.json" --uid 0 --gid 0 --mode 0644 </dev/null >/dev/null || { rm -rf "$tmp"; die "관리 설정 설치 실패"; }
    rm -rf "$tmp"
    # 3) 정적 카나리 — 실패하면 설치를 되돌린다(관문이 깨진 채 켜져 있지 않게)
    if ! python3 "$SBOX_DIR/gate_canary.py" "$name"; then
        say "카나리 실패 — 관문을 되돌립니다"
        cmd_gate "$name" --off >/dev/null 2>&1 || true
        die "관문 설치를 취소했습니다(위 ✘ 항목을 확인)"
    fi
    audit info gate "$name" "관문 설치(관리 설정 env.CLAUDE_CODE_SHELL=/usr/local/bin/sbox-gate-bash, 정적 카나리 통과)"
    say "완료: $name 의 Bash 도구는 이제 명령 관문을 거칩니다 — 선언된 작업(sbox list)과 direct 목록의 명령만 실행됩니다(새 세션부터). 끄기: sboxctl gate $name --off"
}

cmd_taskd() { # cmd_taskd NAME [--manifest F] [--approve] [--remove] — ct 안 **실행자(taskd)** 를 설치·갱신한다(plan sbox-project-policy R6, pilot §29-91)
    local name=${1:-}; shift || true
    check_name "$name"
    [[ $NAME_KIND == ct ]] || die "taskd 는 ct 전용입니다"
    local man="" approve=0 remove=0
    while (($#)); do
        case $1 in
            --manifest) man=${2:?}; shift ;;
            --approve) approve=1 ;;
            --remove) remove=1 ;;
            *) die "알 수 없는 인자: $1" ;;
        esac
        shift
    done
    if ((remove)); then
        incus exec "$name" -- sh -c 'systemctl disable --now sbox-taskd 2>/dev/null; rm -f /etc/systemd/system/sbox-taskd.service /usr/local/bin/sbox; rm -rf /usr/local/lib/sbox-taskd /etc/sbox' </dev/null
        audit info taskd "$name" "taskd 제거"; say "제거: $name 의 taskd"; return 0
    fi
    [[ -n $man ]] || man=$(incus config get "$name" user.sbox.manifest </dev/null 2>/dev/null || true)
    [[ -n $man && -f $man ]] || die "매니페스트를 찾지 못했습니다 — --manifest <파일> (ct 에 연결된 매니페스트: user.sbox.manifest)"
    resolve_ids "$name"
    # 0) ct 안 도구(python3: 경로 확장·taskd, acl: 새 파일 그룹 쓰기 기본 ACL) — 승인 전에 설치해도 해가 없는 것만
    incus exec "$name" --env "PATH=$CT_PATH" -- sh -c '
        command -v python3 >/dev/null 2>&1 && command -v setfacl >/dev/null 2>&1 || { apt-get update -qq >/dev/null && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends python3 acl >/dev/null; }' </dev/null || die "ct 안 python3·acl 설치 실패"
    # 1) 정의 파일(pins) 현재 다이제스트를 ct 안에서 읽는다
    local need digs tmp; need=$(python3 "$SBOX_DIR/tasks.py" needed --manifest "$man") || die "매니페스트의 [tasks] 검증 실패"
    tmp=$(mktemp -d); digs="$tmp/digests.json"; mkdir -p "$tmp/pins"
    python3 - "$need" "$name" "$digs" "$tmp/pins" <<'PY'
import json, os, subprocess, sys
need, name, out, pins = json.loads(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
res = {}
for rel in need:
    r = subprocess.run(["incus", "exec", name, "--", "sha256sum", f"/home/sbox/work/{rel}"], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if r.returncode == 0:
        res[rel] = r.stdout.split()[0]
        # 승인 화면에 보일 본문(앞 64KB+1바이트 — 넘으면 화면이 「앞 64KB 만」이라고 밝힌다)
        b = subprocess.run(["incus", "exec", name, "--", "head", "-c", "65537", f"/home/sbox/work/{rel}"], capture_output=True, stdin=subprocess.DEVNULL)
        if b.returncode == 0:
            dst = os.path.join(pins, *rel.split("/")); os.makedirs(os.path.dirname(dst), exist_ok=True); open(dst, "wb").write(b.stdout)
json.dump(res, open(out, "w"))
PY
    # 1b) R7(가) 보호 경로: 매니페스트 패턴(기본 집합+[protect])을 ct 의 작업 사본에서 확장 — 지금 있는 것만 바인드 마운트 대상(새로 생기면 taskd 가 실행을 거부하고 갱신을 요구)
    local pats; pats=$(python3 "$SBOX_DIR/tasks.py" patterns --manifest "$man") || die "[protect] 검증 실패"
    incus file push "$SBOX_DIR/protect.py" "$name/root/protect.py" --uid 0 --gid 0 --mode 0644 </dev/null >/dev/null || die "protect.py 전달 실패"
    incus exec "$name" -- python3 -I /root/protect.py expand /home/$VM_USER/work "$pats" </dev/null > "$tmp/protected.json" || { incus exec "$name" -- rm -f /root/protect.py </dev/null; rm -rf "$tmp"; die "보호 경로 확장 실패(위 메시지 확인)"; }
    incus exec "$name" -- python3 -I /root/protect.py dirinfo /home/$VM_USER/work "$(cat "$tmp/protected.json")" </dev/null > "$tmp/dirinfo.json" 2>/dev/null || echo '{}' > "$tmp/dirinfo.json"   # 폴더째 보호된 경로의 안쪽 요약(승인 화면용, 실패해도 화면만 덜 자세해진다)
    incus exec "$name" -- rm -f /root/protect.py </dev/null
    # 1c) 승인 화면(S2, plan sbox-project-policy §4-2d): 호스트가 계산한 사실(작업 정의·정의 파일 해시·실행될 스크립트 본문·승인본 대비 diff·위험 신호·보호 경로 요약)을 먼저 보인다.
    #     --approve 는 **사람이 터미널에서 직접** 내용을 보고 `yes` 를 입력할 때만 진행한다(터미널이 아니면 거부 — 에이전트 셸이 스스로 승인하지 못하게).
    local state="${SBOX_APPROVED_DIR:-$HOME/.local/state/sbox/approved}/$name"
    python3 "$SBOX_DIR/review.py" show --manifest "$man" --digests "$digs" --pins "$tmp/pins" --protected "$tmp/protected.json" --dirinfo "$tmp/dirinfo.json" --state "$state" --ct "$name" || { rm -rf "$tmp"; die "승인 화면을 만들지 못했습니다"; }
    if ((approve)); then
        [[ -t 0 && -t 1 ]] || { rm -rf "$tmp"; die "승인은 사람이 터미널에서 직접 해야 합니다(표준 입력·출력이 터미널이 아님) — 위 내용을 확인하고 터미널에서 다시 실행하세요"; }
        local ans; read -r -p "위 내용이 의도하신 변경이 맞으면 yes 를 입력하세요: " ans
        [[ $ans == yes ]] || { rm -rf "$tmp"; die "승인하지 않았습니다(입력: ${ans:-빈 줄}) — 아무것도 바뀌지 않았습니다"; }
    fi
    # 2) 설정 만들기(승인 전이면 여기서 멈춘다 — 사람이 내용을 보고 --approve)
    local flags=(); ((approve)) && flags+=(--approve)
    python3 "$SBOX_DIR/tasks.py" build --manifest "$man" --digests "$digs" --protected "$tmp/protected.json" --out "$tmp/tasks.json" "${flags[@]}" || { rm -rf "$tmp"; die "작업 설정을 만들지 못했습니다"; }
    # 3) ct 준비: python3, 실행 사용자 sbox-run(root 아님, 에이전트 사용자 그룹 sbox), 작업 사본 그룹 쓰기
    incus exec "$name" --env "PATH=$CT_PATH" -- sh -c '
        id sbox-run >/dev/null 2>&1 || useradd --system --create-home --home-dir /var/lib/sbox-run --shell /usr/sbin/nologin sbox-run
        usermod -aG '"$VM_USER"' sbox-run
        mkdir -p /usr/local/lib/sbox-taskd /etc/sbox /var/log/sbox-taskd /run/sbox-taskd /home/'"$VM_USER"'/work
        chown sbox-run:'"$VM_USER"' /var/log/sbox-taskd /var/lib/sbox-run
        chmod 2775 /home/'"$VM_USER"'/work; chmod -R g+rwX /home/'"$VM_USER"'/work 2>/dev/null; find /home/'"$VM_USER"'/work -type d -exec chmod g+s {} + 2>/dev/null; chmod g+x /home/'"$VM_USER"'
        # 에이전트가 앞으로 만드는 새 파일·폴더도 그룹 쓰기가 되게 기본 ACL(umask 022 를 무시, pilot §29-93 시험 ⑥ — 한계 2). node_modules·.git 안은 건너뜀
        find /home/'"$VM_USER"'/work \( -name node_modules -o -name .git \) -prune -o -type d -exec setfacl -d -m u::rwx,g::rwx,o::rx {} + 2>/dev/null
        true' </dev/null || die "ct 준비 실패"
    incus file push "$SBOX_DIR/taskd.py" "$name/usr/local/lib/sbox-taskd/taskd.py" --uid 0 --gid 0 --mode 0644 </dev/null >/dev/null || die "taskd.py 설치 실패"
    incus file push "$SBOX_DIR/protect.py" "$name/usr/local/lib/sbox-taskd/protect.py" --uid 0 --gid 0 --mode 0644 </dev/null >/dev/null || die "protect.py 설치 실패"
    incus file push "$SBOX_DIR/sbox_client.py" "$name/usr/local/bin/sbox" --uid 0 --gid 0 --mode 0755 </dev/null >/dev/null || die "sbox 클라이언트 설치 실패"
    incus file push "$tmp/tasks.json" "$name/etc/sbox/tasks.json" --uid 0 --gid 0 --mode 0644 </dev/null >/dev/null || die "tasks.json 설치 실패"
    # 4) 시스템 유닛(root 가 마운트·제한을 걸고 sbox-run 으로 내려간다 — 작업 프로세스가 상속: 새 권한 금지·네임스페이스 금지·시스템 읽기 전용)
    local binds; binds=$(python3 -c 'import json,sys
for r in json.load(open(sys.argv[2])): print("BindReadOnlyPaths=/home/%s/work/%s" % (sys.argv[1], r))' "$VM_USER" "$tmp/protected.json")
    incus exec "$name" -- sh -c "cat > /etc/systemd/system/sbox-taskd.service" </dev/null <<UNIT
[Unit]
Description=sbox taskd (선언된 작업만 실행하는 실행자)
After=network.target
[Service]
User=sbox-run
Group=$VM_USER
RuntimeDirectory=sbox-taskd
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 -I /usr/local/lib/sbox-taskd/taskd.py --socket /run/sbox-taskd/sock --config /etc/sbox/tasks.json --log /var/log/sbox-taskd/taskd.log --allow-uid $VM_UID --group $VM_GID
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/$VM_USER/work /var/log/sbox-taskd /var/lib/sbox-run
$binds
PrivateTmp=true
PrivateDevices=true
RestrictNamespaces=true
LockPersonality=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
[Install]
WantedBy=multi-user.target
UNIT
    incus exec "$name" -- sh -c "systemctl daemon-reload && systemctl enable sbox-taskd >/dev/null 2>&1 && systemctl restart sbox-taskd" </dev/null || die "taskd 서비스 시작 실패"
    sleep 1
    incus exec "$name" -- systemctl is-active sbox-taskd </dev/null | grep -q '^active' || die "taskd 가 시작되지 않았습니다 — incus exec $name -- journalctl -u sbox-taskd"
    # 승인본 사본(다음 승인의 diff 기준): 작업 정의·정의 파일은 --approve 로 승인했을 때만, 보호 경로 목록은 설치가 끝났을 때마다(보호가 늘어나는 것은 신뢰를 주는 일이 아니다)
    python3 "$SBOX_DIR/review.py" commit --manifest "$man" --digests "$digs" --pins "$tmp/pins" --protected "$tmp/protected.json" --state "$state" --ct "$name" $( ((approve)) || echo --protected-only ) || say "경고: 승인본 사본을 보관하지 못했습니다(다음 승인 때 diff 를 못 보입니다)"
    rm -rf "$tmp"
    audit info taskd "$name" "taskd 설치·갱신($(python3 -c 'import json,sys;print(len(json.load(open(sys.argv[1]))["tasks"]))' <(incus file pull "$name/etc/sbox/tasks.json" - </dev/null)) 개 작업, approve=$approve)"
    say "완료: $name 의 taskd 실행 중 — 에이전트·사용자는 'sbox list' 와 'sbox run <작업>' 만 쓴다(승인: --approve)"
}

# ---- S69 자원 보호: ct 를 sbox.slice 아래에 두고, 만들기 전에 호스트 여유를 본다 (plan dev-sandbox-pilot §29-27) ----
SBOX_SLICE="sbox.slice"
slice_raw_lxc() { # ct 이름이 들어가는 raw.lxc 두 줄(프로필로는 못 한다: %n 이 치환되지 않음 — 시험). S62 는 raw.lxc 가 정확히 이 두 줄인지 점검한다.
    printf 'lxc.cgroup.dir.container=%s/lxc.payload.%s\nlxc.cgroup.dir.monitor=%s/lxc.monitor.%s' "$SBOX_SLICE" "$1" "$SBOX_SLICE" "$1"
}
default_ct_mem() { # 호스트 RAM 의 25%, 최소 2GiB·최대 8GiB(0.5GiB 단위). 사용자가 --memory 로 정하면 쓰이지 않는다(2026-11-23: DB 스택 수요로 상향, 호스트별로 자동 조정)
    awk '/^MemTotal:/{g=$2/1048576*0.25; if(g>8)g=8; if(g<2)g=2; printf "%dMiB", int(g*2)*512}' /proc/meminfo   # Incus 는 소수 GiB(7.5GiB)를 거부한다 — 정수 MiB 로(2026-11-23 겪음)
}
mem_bytes() { # 2GiB·512MiB·1G 같은 값을 바이트로
    python3 -c 'import re,sys
m=re.fullmatch(r"(\d+(?:\.\d+)?)\s*([KMGT]?)(i?B)?",sys.argv[1].strip(),re.I)
print(int(float(m.group(1))*{"":1,"K":1024,"M":1024**2,"G":1024**3,"T":1024**4}[m.group(2).upper()]) if m else 0)' "$1"
}
mem_preflight() { # mem_preflight 요청한한도 — 호스트 여유가 너무 적으면 거부, 빠듯하면 알림(「새로 띄우기 전 확인」 방침)
    local want avail gib
    want=$(mem_bytes "$1"); avail=$(awk '/^MemAvailable:/{print $2*1024}' /proc/meminfo)
    [[ -n $avail ]] || return 0
    gib=$(awk -v b="$avail" 'BEGIN{printf "%.1f", b/1073741824}')
    if ((avail < 3 * 1073741824)); then
        die "호스트 가용 메모리가 ${gib}GiB 로 너무 적어 새 ct 를 만들지 않습니다(3GiB 미만) — 먼저 'hostres' 로 상태를 확인하세요"
    fi
    if ((avail < want + 4 * 1073741824)); then
        say "알림: 호스트 가용 메모리 ${gib}GiB — 이 ct 의 한도($1)가 크면 한도까지 쓰는 순간 호스트가 느려질 수 있습니다(소프트 한도·sbox 합계 상한이 완충)"
    fi
    if [[ -r /sys/fs/cgroup/$SBOX_SLICE/memory.current && -r /sys/fs/cgroup/$SBOX_SLICE/memory.high ]]; then
        local cur high; cur=$(cat /sys/fs/cgroup/$SBOX_SLICE/memory.current); high=$(cat /sys/fs/cgroup/$SBOX_SLICE/memory.high)
        if [[ $high != max ]] && ((cur * 100 / high >= 80)); then
            say "알림: sbox 전체가 이미 합계 상한(high)의 $((cur * 100 / high))% 를 쓰고 있습니다 — 다른 sbox 를 먼저 정리하는 편이 좋습니다"
        fi
    fi
}
install_sbox_mem() { # install_sbox_mem NAME — ct 안에 sbox-mem 과 로그인 알림을 설치
    incus file push --uid 0 --gid 0 --mode 0755 "$SBOX_DIR/sbox-mem.sh" "$1/usr/local/bin/sbox-mem" </dev/null >/dev/null || return 1
    incus exec "$1" -- sh -c 'cat > /etc/profile.d/sbox-mem.sh' </dev/null <<'PROF'
# 로그인할 때 메모리가 한도에 가까우면 한 줄 알림(sbox-mem 으로 자세히)
if [ -r /sys/fs/cgroup/memory.current ] && [ "$(cat /sys/fs/cgroup/memory.high)" != max ]; then
  _c=$(cat /sys/fs/cgroup/memory.current); _h=$(cat /sys/fs/cgroup/memory.high)
  [ "$_h" -gt 0 ] 2>/dev/null && [ $((_c * 100 / _h)) -ge 80 ] && echo "sbox: 메모리 $((_c * 100 / _h))% (high 대비) — 'sbox-mem' 으로 확인" >&2
fi
PROF
}
cmd_scan() { # cmd_scan --from-repo DIR [--manifest F] [--flavor debian|ubuntu] — 저장소를 읽기만 해서 필요한 송신 프리셋 제안(허용은 하지 않음)
    local repo="" man="" flavor=""
    while (($#)); do
        case $1 in
            --from-repo) repo=${2:?}; shift ;;
            --manifest) man=${2:?}; shift ;;
            --flavor) flavor=${2:?}; shift ;;
            *) die "scan: 알 수 없는 인자 $1" ;;
        esac
        shift
    done
    [[ -d $repo ]] || die "사용법: sboxctl scan --from-repo <저장소> [--manifest F] [--flavor debian|ubuntu]"
    [[ -n $man ]] || man="$HOME/.config/sbox/manifests/$(basename "${repo%/}").toml"
    python3 "$SBOX_DIR/scan.py" "$repo" ${man:+--manifest "$man"} ${flavor:+--flavor "$flavor"}
}

cmd_resources() { # cmd_resources NAME — 기존 ct 를 sbox.slice 아래로(재시작) + sbox-mem 설치
    local name=${1:-}; check_name "$name"
    [[ $NAME_KIND == ct ]] || die "resources 는 ct 전용입니다"
    incus info "$name" >/dev/null 2>&1 </dev/null || die "$name 이 없습니다"
    [[ -d /sys/fs/cgroup/$SBOX_SLICE ]] || die "$SBOX_SLICE 가 없습니다 — 호스트에 incus-sbox 모듈 변경이 적용돼야 합니다(nixup os)"
    incus config set "$name" raw.lxc="$(slice_raw_lxc "$name")" </dev/null || die "raw.lxc 설정 실패"
    incus restart "$name" </dev/null || die "재시작 실패"
    wait_ct "$name"
    install_sbox_mem "$name" || die "sbox-mem 설치 실패"
    audit info resources "$name" "sbox.slice 아래로 이동·sbox-mem 설치"
    say "완료: $name 은 이제 $SBOX_SLICE 아래입니다"
}

# ---- S70-a: ct 고정 주소(.200–.250) — 호스트가 이 범위로 ct 를 구분해 게이트웨이 DNS 를 막는다(incus-sbox.nix 의 sbox-guard) ----
CT_IP_PREFIX="10.100.1"; CT_IP_FIRST=200; CT_IP_LAST=250
alloc_ct_ip() { # 쓰이지 않은 첫 주소. 쓰는 중인 주소 = 모든 인스턴스의 고정·현재 IPv4
    local used i
    used=$(incus query "/1.0/instances?recursion=2" </dev/null | python3 -c 'import sys,json
for i in json.load(sys.stdin):
    c=i.get("expanded_devices",{}).get("eth0",{})
    if c.get("ipv4.address"): print(c["ipv4.address"])
    # 정지한 인스턴스는 state.network 가 null — 고정 주소(위)는 이미 셌고, 현재 주소는 없다(예전엔 여기서 TypeError 로 중단돼 뒤 인스턴스의 주소를 빠뜨렸다)
    for a in (((i.get("state") or {}).get("network") or {}).get("eth0") or {}).get("addresses") or []:
        if a["family"]=="inet": print(a["address"])')
    for ((i = CT_IP_FIRST; i <= CT_IP_LAST; i++)); do
        grep -qx "$CT_IP_PREFIX.$i" <<<"$used" || { echo "$CT_IP_PREFIX.$i"; return 0; }
    done
    return 1
}

# ---- L7 관문(broker) — plan dev-sandbox-pilot §29-25 (S61 최소 구현) ----
BROKER="sbox-ct-nixos2605-broker"   # 최소 NixOS 이미지(core/sbox/broker-image — pilot §29-60·76). 이전 Debian ct(sbox-ct-debian13-broker)는 대체됨
BROKER_PORT=3128
BROKER_IMAGE="sbox-broker-nix"      # incus 로컬 이미지 별칭
BROKER_IMG_DIR="${SBOX_BROKER_IMG_DIR:-$HOME/.local/state/sbox/broker-image}"
BROKER_BIN=/run/current-system/sw/bin   # NixOS 이미지에는 PATH 가 없다 — 절대 경로로 부른다
EGRESS_MINIMAL=0  # 1 이면 프로젝트 없이 최소 세트만 연 ct(--no-project)
EGRESS_MAN=""   # cmd_create 가 매니페스트 경로를 채운다(자동 연결에 쓰임)
EGRESS_ACL="sbox-egress"
EGRESS_STATE="${SBOX_EGRESS_STATE:-$HOME/.local/state/sbox/egress-clients.json}"   # 정본(호스트). broker 의 /etc/broker/clients.json 은 이것의 사본

ct_ip() { # ct_ip NAME — eth0 의 IPv4 한 개
    incus list "$1" -f json </dev/null | python3 -c 'import sys,json
d=json.load(sys.stdin)[0]["state"]["network"].get("eth0",{}).get("addresses",[])
print(next((a["address"] for a in d if a["family"]=="inet"),""))'
}

broker_push() { # 호스트의 상태 파일을 broker 에 넣는다 — 프록시는 mtime 이 바뀌면 다시 읽고, 읽다 실패하면 마지막 정상 설정을 유지하며 다음 요청에 다시 읽는다
    incus file push --uid 0 --gid 0 --mode 0644 "$EGRESS_STATE" "$BROKER/etc/broker/clients.json" </dev/null >/dev/null || die "broker 에 설정을 넣지 못했습니다"
}

BROKER_INJECT_PORT=3130
broker_secret_push() { # 진짜 토큰(등록표)을 broker 의 tmpfs 에 넣는다 — 값은 환경변수→표준입력으로만 흐르고 ct 에는 닿지 않는다(S64)
    command -v donghans >/dev/null || { say "경고: donghans 명령이 없어 broker 비밀을 넣지 못했습니다"; return 1; }
    local secret; secret=$(agent_get claude secret) || return 1
    # shellcheck disable=SC2016
    donghans secret run --env "$secret" -- sh -c 'printf %s "$(printenv "$3")" | incus file push - "$1/run/broker-secrets/anthropic" --uid 65534 --gid 65534 --mode 0400' sh "$BROKER" "" "$secret" >/dev/null \
        || { say "경고: broker 에 토큰을 넣지 못했습니다 — 'sboxctl broker secret'"; return 1; }
    audit info broker-secret "$BROKER" "anthropic 토큰을 broker tmpfs 에 주입($secret, 값은 기록 안 함)"
}

broker_active() { incus exec "$BROKER" -- "$BROKER_BIN/systemctl" is-active sbox-broker </dev/null 2>&1 | head -n1; }

wait_broker() { # 최소 이미지에는 ip·sh -c 가 없다 — 서비스가 active 가 될 때까지 기다린다(최대 약 2분)
    local _
    for _ in $(seq 1 60); do
        [[ $(broker_active) == active ]] && return 0
        sleep 2
    done
    die "broker 서비스가 2분 안에 시작되지 않았습니다 — incus exec $BROKER -- $BROKER_BIN/journalctl -u sbox-broker"
}

broker_image_build() { # 이미지를 새로 빌드해 incus 에 가져온다(별칭 교체). 빌드는 오래 걸릴 수 있다(첫 빌드 약 30분).
    mkdir -p "$BROKER_IMG_DIR"
    bash "$SBOX_DIR/broker-image/build.sh" "$BROKER_IMG_DIR" >&2 || die "broker 이미지 빌드 실패"
    broker_image_import
}

broker_image_import() {
    local meta rootfs
    meta=$(ls "$BROKER_IMG_DIR"/metadata/tarball/*.tar.xz 2>/dev/null | head -n1); rootfs=$(ls "$BROKER_IMG_DIR"/rootfs/tarball/*.tar.xz 2>/dev/null | head -n1)
    [[ -n $meta && -n $rootfs ]] || die "빌드된 broker 이미지가 없습니다 — 'sboxctl broker update --build'"
    incus image delete "$BROKER_IMAGE" </dev/null >/dev/null 2>&1 || true
    incus image import "$meta" "$rootfs" --alias "$BROKER_IMAGE" </dev/null >/dev/null || die "broker 이미지 가져오기 실패"
}

broker_launch() { # broker_launch IP — 이미지로 broker ct 를 만들고(고정 주소) 시작, 설정을 밀어 넣는다
    local ip=$1
    incus image info "$BROKER_IMAGE" </dev/null >/dev/null 2>&1 || broker_image_import
    mem_preflight 512MiB
    incus init "$BROKER_IMAGE" "$BROKER" -p sbox-ct -c limits.cpu=1 -c limits.memory=512MiB -c limits.memory.enforce=soft \
        -c "raw.lxc=$(slice_raw_lxc "$BROKER")" -d root,size=5GiB </dev/null >/dev/null || die "broker ct 생성 실패"
    # 프로젝트 ct 들이 L2 로 닿아야 하므로 포트 격리를 끈다(프로젝트 ct 는 켜져 있어 서로는 못 봄), 주소는 ACL 이 가리키므로 고정
    incus config device override "$BROKER" eth0 security.port_isolation=false ${ip:+ipv4.address=$ip} </dev/null >/dev/null || die "broker NIC 설정 실패"
    if incus config show "$BROKER" --expanded 2>/dev/null </dev/null | grep -qE '^\s*security\.privileged:\s*"?true'; then
        incus delete -f "$BROKER" </dev/null >/dev/null 2>&1 || true
        die "정책 위반: 특권 컨테이너가 됐습니다 — 거부하고 삭제했습니다"
    fi
    incus start "$BROKER" </dev/null
    wait_broker
    local real; real=$(ct_ip "$BROKER"); [[ -n $real ]] || die "broker IP 를 읽지 못했습니다"
    [[ -z $ip || $real == "$ip" ]] || say "경고: broker 주소가 요청($ip)과 다릅니다($real) — 'sboxctl egress NAME' 으로 ct 를 다시 연결하세요"
    if [[ ! -f $EGRESS_STATE ]]; then   # 클라이언트 없는 상태 파일(기본 허용 세트만)
        python3 "$SBOX_DIR/egress.py" remove --state "$EGRESS_STATE" --name __none__ >/dev/null
    fi
    broker_push
    broker_secret_push || true
    echo "$real"
}

cmd_broker() {
    case "${1:-}" in
        status)
            incus info "$BROKER" >/dev/null 2>&1 </dev/null || { say "broker 없음 — 'sboxctl broker create'"; return 0; }
            say "broker $BROKER  $(ct_ip "$BROKER"):$BROKER_PORT  $(broker_active)"
            incus exec "$BROKER" -- "$BROKER_BIN/bash" -c '[ -s /run/broker-secrets/anthropic ]' </dev/null >/dev/null 2>&1 && say "  anthropic 비밀: 있음" || say "  anthropic 비밀: **없음** — 'sboxctl broker secret' (없으면 키 주입 ct 의 요청이 503)"
            python3 "$SBOX_DIR/egress.py" show --state "$EGRESS_STATE" | python3 -c 'import sys,json
d=json.load(sys.stdin)
print("  공통 허용 %d개(S71 이후 보통 0 — 허용은 프리셋으로 클라이언트별)" % len(d.get("default_allow",[])))
for ip,c in sorted(d.get("clients",{}).items()):
    by={}
    for s in c.get("sources",{}).values(): by[s]=by.get(s,0)+1
    print("  %-16s %s 허용 %d개 (%s)" % (ip,c["name"],len(c["allow"]),", ".join("%s %d"%kv for kv in by.items())))'
            incus file pull "$BROKER/var/log/broker/access.log" - </dev/null 2>/dev/null | tail -n 5 || true
            return 0 ;;
        update)   # [--build]: 이미지를 (필요하면 다시 빌드해) 가져온 뒤 ct 를 교체한다 — 같은 주소·같은 설정. 상태는 호스트의 상태 파일뿐이라 잃는 것이 없다(접속 기록은 ct 와 함께 사라짐: 필요하면 먼저 복사)
            incus info "$BROKER" >/dev/null 2>&1 </dev/null || die "broker 가 없습니다 — 'sboxctl broker create'"
            [[ ${2:-} == --build ]] && broker_image_build || broker_image_import
            local old; old=$(ct_ip "$BROKER"); [[ -n $old ]] || die "broker IP 를 읽지 못했습니다"
            say "broker 교체: $BROKER ($old) 를 지우고 새 이미지로 같은 주소에 다시 만듭니다"
            incus delete -f "$BROKER" </dev/null >/dev/null || die "기존 broker 삭제 실패"
            local ip; ip=$(broker_launch "$old")
            audit info broker-update "$BROKER" "broker 교체 $ip (이미지 $(incus image info "$BROKER_IMAGE" </dev/null 2>/dev/null | sed -n 's/^Fingerprint: //p' | cut -c1-12))"
            say "완료: broker 교체($ip — 프록시 $BROKER_PORT·투명 TLS 443·DNS 53). 주소가 같으면 ct 재연결은 필요 없습니다"
            return 0 ;;
        secret)   # [--if-missing]: broker 가 떠 있는데 비밀이 비어 있을 때만 넣는다(호스트 재부팅·broker 재시작 뒤 자동 복구용 — 타이머가 주기적으로 부른다, 정상이면 조용히 종료)
            if [[ ${2:-} == --if-missing ]]; then
                incus info "$BROKER" >/dev/null 2>&1 </dev/null || return 0
                [[ $(broker_active) == active ]] || return 0
                incus exec "$BROKER" -- "$BROKER_BIN/bash" -c '[ -s /run/broker-secrets/anthropic ]' </dev/null >/dev/null 2>&1 && return 0
                broker_secret_push && say "broker 의 anthropic 토큰이 비어 있어 다시 넣었습니다" || return 1
                return 0
            fi
            incus info "$BROKER" >/dev/null 2>&1 </dev/null || die "broker 가 없습니다"; broker_secret_push || exit 1; say "완료: broker 에 anthropic 토큰 주입(tmpfs)"; return 0 ;;
        create)
            incus info "$BROKER" >/dev/null 2>&1 </dev/null && die "$BROKER 는 이미 있습니다"
            incus image info "$BROKER_IMAGE" </dev/null >/dev/null 2>&1 || { [[ -d $BROKER_IMG_DIR ]] || broker_image_build; }
            local ip; ip=$(broker_launch "${2:-}")
            audit info broker-create "$BROKER" "broker $ip:$BROKER_PORT"
            say "완료: broker $ip:$BROKER_PORT — 프로젝트 ct 는 'sboxctl egress NAME' 으로 연결(create 는 자동)" ;;
        *) die "사용법: sboxctl broker create [IP]|status|update [--build]|secret [--if-missing]" ;;
    esac
}

cmd_egress() { # cmd_egress NAME [--from-repo DIR|--manifest F] [--allow H[:P]]...
    local name=${1:-}; shift || true
    check_name "$name"
    [[ $NAME_KIND == ct ]] || die "egress 는 ct 전용입니다"
    [[ $name != "$BROKER" ]] || die "broker 자신은 연결하지 않습니다"
    incus info "$BROKER" >/dev/null 2>&1 </dev/null || die "broker 가 없습니다 — 먼저 'sboxctl broker create'"
    local man="" minimal=0 ; local -a allow=()
    while (($#)); do
        case $1 in
            --minimal) minimal=1 ;;
            --from-repo) man="$HOME/.config/sbox/manifests/$(basename "${2%/}").toml"; shift ;;
            --manifest) man=${2:?}; shift ;;
            --allow) allow+=(--allow "${2:?}"); shift ;;
            *) die "알 수 없는 옵션: $1" ;;
        esac
        shift
    done
    # 인자가 없으면 만들 때 기록한 연결(user.sbox.manifest·user.sbox.egress-minimal)을 쓴다 — ct 와 매니페스트의 연결이 기록으로 남는다
    if [[ -z $man ]] && ((!minimal)); then
        man=$(incus config get "$name" user.sbox.manifest </dev/null 2>/dev/null || true)
        [[ $(incus config get "$name" user.sbox.egress-minimal </dev/null 2>/dev/null || true) == 1 ]] && minimal=1
    fi
    [[ -n $man ]] || ((minimal)) || die "$name 에 연결된 프로젝트가 없습니다 — --from-repo <저장소>|--manifest <파일>, 또는 최소 세트만 쓰는 --minimal"
    if [[ -n $man ]]; then incus config set "$name" user.sbox.manifest="$man" </dev/null; fi
    if ((minimal)) && [[ -z $man ]]; then incus config set "$name" user.sbox.egress-minimal=1 </dev/null; fi
    local ip bip; ip=$(ct_ip "$name"); bip=$(ct_ip "$BROKER")
    [[ -n $ip && -n $bip ]] || die "ct·broker 의 IP 를 읽지 못했습니다"
    python3 "$SBOX_DIR/egress.py" set --state "$EGRESS_STATE" --name "$name" --ip "$ip" ${man:+--manifest "$man"} $( ((minimal)) && [[ -z $man ]] && echo --minimal ) "${allow[@]}" || die "허용목록 계산 실패"
    broker_push
    # NIC ACL: broker 의 프록시 포트(+게이트웨이 DNS)만 허용, 나머지 송신은 drop(기록)
    if ! incus network acl show "$EGRESS_ACL" >/dev/null 2>&1 </dev/null; then
        incus network acl create "$EGRESS_ACL" </dev/null >/dev/null
    fi
    # 규칙 전체를 한 번에 교체(broker IP 가 바뀌었어도 같은 모양, 중복 없음) — 주의: 파이프 뒤에 </dev/null 을 붙이면 입력이 사라진다
    python3 "$SBOX_DIR/egress.py" acl --broker "$bip" --port "$BROKER_PORT" --acl-name "$EGRESS_ACL" | incus network acl edit "$EGRESS_ACL" || die "ACL 규칙 실패"
    local verb=set
    incus config device show "$name" </dev/null | grep -q '^eth0:' || verb=override
    if [[ $verb == override ]]; then
        incus config device override "$name" eth0 ipv4.address="$ip" security.ipv4_filtering=true security.acls="$EGRESS_ACL" \
            security.acls.default.egress.action=drop security.acls.default.egress.logged=true </dev/null || die "NIC 설정 실패"
    else
        incus config device set "$name" eth0 ipv4.address="$ip" security.ipv4_filtering=true security.acls="$EGRESS_ACL" \
            security.acls.default.egress.action=drop security.acls.default.egress.logged=true </dev/null || die "NIC 설정 실패"
    fi
    # ct 안: 프록시 환경 — apt 는 전용 설정, 나머지는 환경변수(로그인·systemd 모두), rootless Docker 데몬은 사용자 서비스 환경
    local px="http://$bip:$BROKER_PORT"
    incus exec "$name" --env "PATH=$CT_PATH" -- sh -c "
        set -e
        # broker 는 CONNECT 만 받는다 — apt 저장소를 https 로 바꾸고 https 프록시만 건다(http:// 는 403)
        sed -i 's#http://#https://#g' /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list 2>/dev/null || true
        printf 'Acquire::https::Proxy \"%s\";\n' '$px' > /etc/apt/apt.conf.d/99sbox-broker
        # DNS 는 broker 스텁만(허용된 이름만 진짜 주소로 답한다), 기본 게이트웨이는 broker(방식 B, pilot §29-37) — DHCP 가 주는 게이트웨이·DNS 는 쓰지 않는다
        mkdir -p /etc/systemd/network/eth0.network.d
        printf '[Network]\nDNS=%s\nGateway=%s\n[DHCPv4]\nUseDNS=no\nUseGateway=no\n' '$bip' '$bip' > /etc/systemd/network/eth0.network.d/sbox-dns.conf
        mkdir -p /etc/systemd/resolved.conf.d
        printf '[Resolve]\nDomains=~.\n' > /etc/systemd/resolved.conf.d/sbox-dns.conf
        (networkctl reload && networkctl reconfigure eth0 && systemctl restart systemd-resolved) >/dev/null 2>&1 || true
        sed -i '/^# sbox-broker begin/,/^# sbox-broker end/d' /etc/environment
        printf '# sbox-broker begin\nHTTP_PROXY=%s\nHTTPS_PROXY=%s\nhttp_proxy=%s\nhttps_proxy=%s\nNO_PROXY=localhost,127.0.0.1,10.100.1.1\nno_proxy=localhost,127.0.0.1,10.100.1.1\n# sbox-broker end\n' '$px' '$px' '$px' '$px' >> /etc/environment
        if [ -d /home/$VM_USER ]; then
            d=/home/$VM_USER/.config/systemd/user/docker.service.d; mkdir -p \$d
            printf '[Service]\nEnvironment=\"HTTP_PROXY=%s\" \"HTTPS_PROXY=%s\" \"NO_PROXY=localhost,127.0.0.1\"\n' '$px' '$px' > \$d/sbox-broker.conf
            chown -R $VM_USER: /home/$VM_USER/.config 2>/dev/null || true
            # 이미 떠 있는 rootless Docker 데몬은 환경을 다시 읽어야 한다(설치 뒤 연결하는 흐름이라 필수)
            U=\$(id -u $VM_USER)
            if [ -S /run/user/\$U/bus ] && [ -e /home/$VM_USER/.config/systemd/user/default.target.wants/docker.service ]; then
                su -s /bin/sh $VM_USER -c \"export XDG_RUNTIME_DIR=/run/user/\$U; systemctl --user daemon-reload; systemctl --user restart docker\" || true
            fi
        fi" </dev/null || die "ct 안 프록시 설정 실패"
    audit info egress "$name" "broker 연결 $ip → $bip:$BROKER_PORT (NIC ACL $EGRESS_ACL, 기본 drop)"
    say "완료: $name ($ip) 는 이제 broker($bip:$BROKER_PORT)로만 외부에 나갑니다 — 허용목록은 'sboxctl broker status'"
}

egress_detach() { # destroy 가 부름 — broker 표에서 지움(broker 가 없으면 조용히 넘어감)
    [[ -f $EGRESS_STATE ]] || return 0
    python3 "$SBOX_DIR/egress.py" remove --state "$EGRESS_STATE" --name "$1" >/dev/null 2>&1 || return 0
    incus info "$BROKER" >/dev/null 2>&1 </dev/null && broker_push || true
}

cmd_list() { incus list '^sbox-' -c ns4 -f compact; }

case "${1:-}" in
    create) shift; cmd_create "$@" ;;
    bundle) shift; cmd_bundle "$@" ;;
    releases) shift; python3 "$SBOX_DIR/release.py" list "${1:-}" ;;
    destroy) shift; cmd_destroy "$@" ;;
    import) shift; cmd_import "${1:-}" ;;
    golden) shift; cmd_golden "$@" ;;
    rebuild-golden) shift; cmd_rebuild_golden "$@" ;;
    iso) shift; cmd_iso "$@" ;;
    cache) shift; cmd_cache "${1:-}" ;;
    token) shift; cmd_token "${1:-}" "${2:-}" "${3:-}" ;;
    home) shift; cmd_home "${1:-}" ;;
    llm) shift; cmd_llm "$@" ;;
    skills) shift; cmd_skills "$@" ;;
    taskd) shift; cmd_taskd "$@" ;;
    gate) shift; cmd_gate "$@" ;;
    tools) shift; cmd_tools "$@" ;;
    docker) shift; cmd_docker "$@" ;;
    broker) shift; cmd_broker "$@" ;;
    audit) shift; python3 "$SBOX_DIR/audit.py" "$@" ;;
    scan) shift; cmd_scan "$@" ;;
    resources) shift; cmd_resources "${1:-}" ;;
    egress) shift; cmd_egress "$@" ;;
    depwatch) shift; python3 "$SBOX_DIR/depwatch.py" "$@" ;;
    list) cmd_list ;;
    *) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
