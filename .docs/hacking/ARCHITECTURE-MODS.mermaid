%%{init: {'theme': 'dark', 'flowchart': {'curve': 'basis'}}}%%
flowchart TD
    subgraph SCAN["① 모듈 스캐닝  ·  recursiveImportDir"]
        direction LR
        nix_files["`**.nix 파일**
        mods/ 하위 재귀 탐색`"]
        filter["`**필터**
        _ prefix · *.home.nix
        *.overlay.nix · default.nix
        → 제외`"]
        nix_files --> filter
    end

    subgraph DUAL["② Dual-Context  ·  양쪽 주입"]
        direction LR
        nixos_ctx["`**NixOS modules**
        forOS = true
        → body.**os** 적용`"]
        hm_ctx["`**HM sharedModules**
        forOS = false
        → body.**hm** 적용`"]
    end

    subgraph HELPER["③ 헬퍼 패턴  ·  옵션 자동 선언"]
        direction LR
        mkmod["`**mkMod**
        독립 enable
        preset 등록 필요`"]
        mkmodof["`**mkModOf**
        부모 cascade
        mkDefault true`"]
        mkpartof["`**mkPartOf**
        enable 없음
        부모 종속`"]
    end

    subgraph ENABLE["④ Enable 계층"]
        direction TB
        master["`**마스터 스위치**
        gui.nix · devel.nix
        mods.gui.enable = true`"]
        cascade["`**cascade**
        vivaldi.enable = mkDefault true
        (host.toml로 오버라이드 가능)`"]
        part["`**part**
        fuzzel (enable 없음)
        부모 enable에 종속`"]
        master --> cascade --> part
    end

    subgraph APPLY["⑤ 최종 적용"]
        direction LR
        preset["`**preset TOML**
        + host.toml
        → modsModule 주입`"]
        autowrap["`**autoWrap**
        mkIf cfg.enable
        자동 적용`"]
        preset --> autowrap
    end

    filter --> DUAL
    DUAL --> HELPER
    HELPER --> ENABLE
    ENABLE --> preset
    autowrap --> Out(["✓ NixOS / HM config"])

    style SCAN fill:#1e2a3a,stroke:#4a9eff,color:#cdd6f4
    style DUAL fill:#2a1e2a,stroke:#c97bff,color:#cdd6f4
    style HELPER fill:#1a2a1a,stroke:#4aff7a,color:#cdd6f4
    style ENABLE fill:#2a2a1a,stroke:#ffcc4a,color:#cdd6f4
    style APPLY fill:#2a1a1a,stroke:#ff7b7b,color:#cdd6f4
    style Out fill:#1e3a2a,stroke:#a6e3a1,color:#cdd6f4
